{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"HOS","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/HOS/1.json","firstChapterReference":{"translationId":"BSB","book":"HOS","chapter":1},"lastChapterNumber":14,"lastChapterApiLink":"/api/BSB/HOS/14.json","lastChapterReference":{"translationId":"BSB","book":"HOS","chapter":14},"numberOfChapters":14,"totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"heading","content":["A Reproof of Ephraim, Judah, and Jacob"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Ephraim","poem":1},{"noteId":57},{"text":"chases the wind","poem":1},{"text":"and pursues the east wind all day long;","poem":2},{"text":"he multiplies lies and violence;","poem":2},{"text":"he makes a covenant with Assyria","poem":1},{"text":"and sends olive oil to Egypt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"The LORD also brings a charge against Judah.","poem":1},{"text":"He will punish Jacob","poem":2},{"noteId":58},{"text":"according to his ways","poem":2},{"text":"and repay him according to his deeds.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"In the womb he grasped his brother’s heel,","poem":1},{"text":"and in his vigor he wrestled with God.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yes, he struggled with the angel","poem":1},{"noteId":59},{"text":"and prevailed;","poem":1},{"text":"he wept and sought His favor;","poem":2},{"text":"he found Him at Bethel","poem":1},{"text":"and spoke with Him there","poem":2},{"noteId":60},{"text":"—","poem":2}]},{"type":"verse","number":5,"content":[{"text":"the LORD is the God of Hosts—","poem":1},{"text":"the LORD is His name of renown.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"But you must return to your God,","poem":1},{"text":"maintaining love and justice,","poem":2},{"text":"and always waiting on your God.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A merchant loves to defraud","poem":1},{"text":"with dishonest scales in his hands.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"And Ephraim boasts: “How rich I have become!","poem":1},{"text":"I have found wealth for myself.","poem":2},{"text":"In all my labors, they can find in me","poem":1},{"text":"no iniquity that is sinful.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"But I am the LORD your God","poem":1},{"text":"ever since the land of Egypt.","poem":2},{"text":"I will again make you dwell in tents,","poem":1},{"text":"as in the days of the appointed feast.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I spoke through the prophets","poem":1},{"text":"and multiplied their visions;","poem":2},{"text":"I gave parables through the prophets.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Is there iniquity in Gilead?","poem":1},{"text":"They will surely come to nothing.","poem":2},{"text":"Do they sacrifice bulls in Gilgal?","poem":1},{"text":"Indeed, their altars will be heaps of stones","poem":2},{"text":"in the furrows of the field.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jacob fled to the land of Aram","poem":1},{"noteId":61},{"text":"and Israel worked for a wife—","poem":2},{"text":"for a wife he tended sheep.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"But by a prophet the LORD brought Israel out of Egypt,","poem":1},{"text":"and by a prophet he was preserved.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ephraim has provoked bitter anger,","poem":1},{"text":"so his Lord will leave his bloodguilt upon him","poem":2},{"text":"and repay him for his contempt.","poem":2}]}],"footnotes":[{"noteId":57,"text":"That is, the northern kingdom of Israel; also in verses 8 and 14","caller":"+","reference":{"chapter":12,"verse":1}},{"noteId":58,"text":"Jacob means he grasps the heel or he deceives.","caller":"+","reference":{"chapter":12,"verse":2}},{"noteId":59,"text":"Or Angel","caller":"+","reference":{"chapter":12,"verse":4}},{"noteId":60,"text":"LXX and Syriac; MT and there He spoke with us","caller":"+","reference":{"chapter":12,"verse":4}},{"noteId":61,"text":"That is, northwest Mesopotamia","caller":"+","reference":{"chapter":12,"verse":12}}]},"thisChapterLink":"/api/BSB/HOS/12.json","thisChapterReference":{"translationId":"BSB","book":"HOS","chapter":12},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/HOS/12/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/HOS/12/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/HOS/12/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/HOS/13.json","nextChapterReference":{"translationId":"BSB","book":"HOS","chapter":13},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/HOS/13/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/HOS/13/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/HOS/13/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/HOS/11.json","previousChapterReference":{"translationId":"BSB","book":"HOS","chapter":11},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/HOS/11/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/HOS/11/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/HOS/11/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":14}