{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"HOS","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/HOS/1.json","firstChapterReference":{"translationId":"BSB","book":"HOS","chapter":1},"lastChapterNumber":14,"lastChapterApiLink":"/api/BSB/HOS/14.json","lastChapterReference":{"translationId":"BSB","book":"HOS","chapter":14},"numberOfChapters":14,"totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["The Unrepentance of Israel and Judah"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Come, let us return to the LORD.","poem":1},{"lineBreak":true},{"text":"For He has torn us to pieces,","poem":1},{"text":"but He will heal us;","poem":2},{"text":"He has wounded us,","poem":1},{"text":"but He will bind up our wounds.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"After two days He will revive us;","poem":1},{"text":"on the third day He will raise us up,","poem":2},{"text":"that we may live in His presence.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"So let us know—","poem":1},{"text":"let us press on to know the LORD.","poem":2},{"text":"As surely as the sun rises,","poem":1},{"text":"He will appear;","poem":2},{"text":"He will come to us like the rain,","poem":1},{"text":"like the spring showers that water the earth.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"What shall I do with you, O Ephraim","poem":1},{"noteId":34},{"text":"?","poem":1},{"text":"What shall I do with you, O Judah?","poem":2},{"text":"For your loyalty is like a morning mist,","poem":1},{"text":"like the early dew that vanishes.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Therefore I have hewn them by the prophets;","poem":1},{"text":"I have slain them by the words of My mouth,","poem":2},{"text":"and My judgments go forth like lightning.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"For I desire mercy, not sacrifice,","poem":1},{"noteId":35},{"text":"and the knowledge of God","poem":2},{"text":"rather than burnt offerings.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"But they, like Adam, have transgressed","poem":1},{"noteId":36},{"text":"the covenant;","poem":1},{"text":"there they were unfaithful to Me.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gilead is a city of evildoers,","poem":1},{"text":"tracked with footprints of blood.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Like raiders who lie in ambush,","poem":1},{"text":"so does a band of priests;","poem":2},{"text":"they murder on the way to Shechem;","poem":1},{"text":"surely they have committed atrocities.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"In the house of Israel","poem":1},{"text":"I have seen a horrible thing:","poem":2},{"text":"Ephraim practices prostitution there,","poem":1},{"text":"and Israel is defiled.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Also for you, O Judah,","poem":1},{"text":"a harvest is appointed,","poem":2},{"text":"when I restore","poem":1},{"text":"My people from captivity.","poem":2},{"noteId":37}]}],"footnotes":[{"noteId":34,"text":"That is, the northern kingdom of Israel; also in verse 10","caller":"+","reference":{"chapter":6,"verse":4}},{"noteId":35,"text":"Cited in Matthew 9:13 and Matthew 12:7","caller":"+","reference":{"chapter":6,"verse":6}},{"noteId":36,"text":"Or As at Adam, they have transgressed","caller":"+","reference":{"chapter":6,"verse":7}},{"noteId":37,"text":"Or restore the fortunes of My people","caller":"+","reference":{"chapter":6,"verse":11}}]},"thisChapterLink":"/api/BSB/HOS/6.json","thisChapterReference":{"translationId":"BSB","book":"HOS","chapter":6},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/HOS/6/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/HOS/6/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/HOS/6/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/HOS/7.json","nextChapterReference":{"translationId":"BSB","book":"HOS","chapter":7},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/HOS/7/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/HOS/7/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/HOS/7/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/HOS/5.json","previousChapterReference":{"translationId":"BSB","book":"HOS","chapter":5},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/HOS/5/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/HOS/5/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/HOS/5/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":11}