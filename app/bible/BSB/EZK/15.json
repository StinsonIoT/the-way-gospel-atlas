{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"EZK","name":"Ezekiel","commonName":"Ezekiel","title":"Ezekiel","order":26,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/EZK/1.json","firstChapterReference":{"translationId":"BSB","book":"EZK","chapter":1},"lastChapterNumber":48,"lastChapterApiLink":"/api/BSB/EZK/48.json","lastChapterReference":{"translationId":"BSB","book":"EZK","chapter":48},"numberOfChapters":48,"totalNumberOfVerses":1273},"chapter":{"number":15,"content":[{"type":"heading","content":["Jerusalem the Useless Vine"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Then the word of the LORD came to me, saying,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Son of man, how does the wood of the vine surpass any other branch among the trees in the forest?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Can wood be taken from it to make something useful? Or can one make from it a peg on which to hang utensils?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"No, it is cast into the fire for fuel. The fire devours both ends, and the middle is charred. Can it be useful for anything?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Even when it was whole, it could not be made useful. How much less can it ever be useful when the fire has consumed it and charred it!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Therefore this is what the Lord GOD says: ‘Like the wood of the vine among the trees of the forest, which I have given to the fire for fuel, so I will give up the people of Jerusalem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"And I will set My face against them. Though they may have escaped the fire, yet another fire will consume them. And when I set My face against them, you will know that I am the LORD.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Thus I will make the land desolate, because they have acted unfaithfully,’ declares the Lord GOD.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/BSB/EZK/15.json","thisChapterReference":{"translationId":"BSB","book":"EZK","chapter":15},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/EZK/15/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/EZK/15/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/EZK/15/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/EZK/16.json","nextChapterReference":{"translationId":"BSB","book":"EZK","chapter":16},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/EZK/16/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/EZK/16/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/EZK/16/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/EZK/14.json","previousChapterReference":{"translationId":"BSB","book":"EZK","chapter":14},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/EZK/14/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/EZK/14/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/EZK/14/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":8}