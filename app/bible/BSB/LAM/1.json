{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"LAM","name":"Lamentations","commonName":"Lamentations","title":"Lamentations","order":25,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/LAM/1.json","firstChapterReference":{"translationId":"BSB","book":"LAM","chapter":1},"lastChapterNumber":5,"lastChapterApiLink":"/api/BSB/LAM/5.json","lastChapterReference":{"translationId":"BSB","book":"LAM","chapter":5},"numberOfChapters":5,"totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["How Lonely Lies the City!"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"How","poem":1},{"noteId":0},{"text":"lonely lies the city,","poem":1},{"text":"once so full of people!","poem":2},{"text":"She who was great among the nations","poem":1},{"text":"has become a widow.","poem":2},{"text":"The princess of the provinces","poem":1},{"text":"has become a slave.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"She weeps aloud in the night,","poem":1},{"text":"with tears upon her cheeks.","poem":2},{"text":"Among all her lovers","poem":1},{"text":"there is no one to comfort her.","poem":2},{"text":"All her friends have betrayed her;","poem":1},{"text":"they have become her enemies.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Judah has gone into exile","poem":1},{"text":"under affliction and harsh slavery;","poem":2},{"text":"she dwells among the nations","poem":1},{"text":"but finds no place to rest.","poem":2},{"text":"All her pursuers have overtaken her","poem":1},{"text":"in the midst of her distress.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"The roads to Zion mourn,","poem":1},{"text":"because no one comes to her appointed feasts.","poem":2},{"text":"All her gates are deserted;","poem":1},{"text":"her priests groan,","poem":2},{"text":"her maidens grieve,","poem":1},{"text":"and she herself is bitter with anguish.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Her foes have become her masters;","poem":1},{"text":"her enemies are at ease.","poem":2},{"text":"For the LORD has brought her grief","poem":1},{"text":"because of her many transgressions.","poem":2},{"text":"Her children have gone away","poem":1},{"text":"as captives before the enemy.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"All the splendor has departed","poem":1},{"text":"from the Daughter of Zion.","poem":2},{"text":"Her princes are like deer","poem":1},{"text":"that find no pasture;","poem":2},{"text":"they lack the strength to flee","poem":1},{"text":"in the face of the hunter.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"In the days of her affliction and wandering","poem":1},{"text":"Jerusalem remembers all the treasures","poem":2},{"text":"that were hers in days of old.","poem":2},{"text":"When her people fell into enemy hands","poem":1},{"text":"she received no help.","poem":2},{"text":"Her enemies looked upon her,","poem":1},{"text":"laughing at her downfall.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jerusalem has sinned greatly;","poem":1},{"text":"therefore she has become an object of scorn.","poem":2},{"text":"All who honored her now despise her,","poem":1},{"text":"for they have seen her nakedness;","poem":2},{"noteId":1},{"text":"she herself groans and turns away.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Her uncleanness stains her skirts;","poem":1},{"text":"she did not consider her end.","poem":2},{"text":"Her downfall was astounding;","poem":1},{"text":"there was no one to comfort her.","poem":2},{"text":"Look, O LORD, on my affliction,","poem":1},{"text":"for the enemy has triumphed!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"The adversary has seized","poem":1},{"text":"all her treasures.","poem":2},{"text":"For she has seen the nations","poem":1},{"text":"enter her sanctuary—","poem":2},{"text":"those You had forbidden","poem":1},{"text":"to enter Your assembly.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"All her people groan","poem":1},{"text":"as they search for bread.","poem":2},{"text":"They have traded their treasures for food","poem":1},{"text":"to keep themselves alive.","poem":2},{"text":"Look, O LORD, and consider,","poem":1},{"text":"for I have become despised.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Is this nothing to you, all you who pass by?","poem":1},{"text":"Look around and see!","poem":2},{"text":"Is there any sorrow like mine,","poem":1},{"text":"which was inflicted on me,","poem":2},{"text":"which the LORD made me suffer","poem":1},{"text":"on the day of His fierce anger?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"He sent fire from on high,","poem":1},{"text":"and it overpowered my bones.","poem":2},{"text":"He spread a net for my feet","poem":1},{"text":"and turned me back.","poem":2},{"text":"He made me desolate,","poem":1},{"text":"faint all the day long.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"My transgressions are bound into a yoke,","poem":1},{"noteId":2},{"text":"knit together by His hand;","poem":2},{"text":"they are draped over my neck,","poem":1},{"text":"and the Lord has broken my strength.","poem":2},{"text":"He has delivered me into the hands","poem":1},{"text":"of those I cannot withstand.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"The Lord has rejected","poem":1},{"text":"all the mighty men in my midst;","poem":2},{"text":"He has summoned an army against me","poem":1},{"noteId":3},{"text":"to crush my young warriors.","poem":2},{"text":"Like grapes in a winepress,","poem":1},{"text":"the Lord has trampled the Virgin Daughter of Judah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"For these things I weep;","poem":1},{"text":"my eyes flow with tears.","poem":2},{"text":"For there is no one nearby to comfort me,","poem":1},{"text":"no one to revive my soul.","poem":2},{"text":"My children are destitute","poem":1},{"text":"because the enemy has prevailed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zion stretches out her hands,","poem":1},{"text":"but there is no one to comfort her.","poem":2},{"text":"The LORD has decreed against Jacob","poem":1},{"text":"that his neighbors become his foes.","poem":2},{"text":"Jerusalem has become","poem":1},{"text":"an unclean thing among them.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"The LORD is righteous,","poem":1},{"text":"for I have rebelled against His command.","poem":2},{"text":"Listen, all you people;","poem":1},{"text":"look upon my suffering.","poem":2},{"text":"My young men and maidens","poem":1},{"text":"have gone into captivity.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"I called out to my lovers,","poem":1},{"text":"but they have betrayed me.","poem":2},{"text":"My priests and elders","poem":1},{"text":"perished in the city","poem":2},{"text":"while they searched for food","poem":1},{"text":"to keep themselves alive.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"See, O LORD, how distressed I am!","poem":1},{"text":"I am churning within;","poem":2},{"text":"my heart is pounding within me,","poem":1},{"text":"for I have been most rebellious.","poem":2},{"text":"Outside, the sword bereaves;","poem":1},{"text":"inside, there is death.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"People have heard my groaning,","poem":1},{"text":"but there is no one to comfort me.","poem":2},{"text":"All my enemies have heard of my trouble;","poem":1},{"text":"they are glad that You have caused it.","poem":2},{"text":"May You bring the day You have announced,","poem":1},{"text":"so that they may become like me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Let all their wickedness come before You,","poem":1},{"text":"and deal with them","poem":2},{"text":"as You have dealt with me","poem":1},{"text":"because of all my transgressions.","poem":2},{"text":"For my groans are many,","poem":1},{"text":"and my heart is faint.","poem":2}]}],"footnotes":[{"noteId":0,"text":"This chapter is an acrostic poem, each verse beginning with the successive letters of the Hebrew alphabet.","caller":"+","reference":{"chapter":1,"verse":1}},{"noteId":1,"text":"Or her shame","caller":"+","reference":{"chapter":1,"verse":8}},{"noteId":2,"text":"Most Hebrew manuscripts; other Hebrew manuscripts and LXX He kept watch over my sins","caller":"+","reference":{"chapter":1,"verse":14}},{"noteId":3,"text":"Or has set a time for me","caller":"+","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/BSB/LAM/1.json","thisChapterReference":{"translationId":"BSB","book":"LAM","chapter":1},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/LAM/1/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/LAM/1/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/LAM/1/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/LAM/2.json","nextChapterReference":{"translationId":"BSB","book":"LAM","chapter":2},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/LAM/2/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/LAM/2/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/LAM/2/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/JER/52.json","previousChapterReference":{"translationId":"BSB","book":"JER","chapter":52},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JER/52/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JER/52/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JER/52/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":22}