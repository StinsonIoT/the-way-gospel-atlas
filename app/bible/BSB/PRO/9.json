{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PRO","name":"Proverbs","commonName":"Proverbs","title":"Proverbs","order":20,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PRO/1.json","firstChapterReference":{"translationId":"BSB","book":"PRO","chapter":1},"lastChapterNumber":31,"lastChapterApiLink":"/api/BSB/PRO/31.json","lastChapterReference":{"translationId":"BSB","book":"PRO","chapter":31},"numberOfChapters":31,"totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["The Way of Wisdom"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Wisdom has built her house;","poem":1},{"text":"she has carved out","poem":2},{"noteId":32},{"text":"her seven pillars.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"She has prepared her meat and mixed her wine;","poem":1},{"text":"she has also set her table.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"She has sent out her maidservants;","poem":1},{"text":"she calls out from the heights of the city.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Whoever is simple, let him turn in here!”","poem":1},{"text":"she says to him who lacks judgment.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Come, eat my bread","poem":1},{"text":"and drink the wine I have mixed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Leave your folly behind, and you will live;","poem":1},{"text":"walk in the way of understanding.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"He who corrects a mocker brings shame on himself;","poem":1},{"text":"he who rebukes a wicked man taints himself.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Do not rebuke a mocker, or he will hate you;","poem":1},{"text":"rebuke a wise man, and he will love you.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Instruct a wise man, and he will be wiser still;","poem":1},{"text":"teach a righteous man, and he will increase his learning.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"The fear of the LORD is the beginning of wisdom,","poem":1},{"text":"and knowledge of the Holy One is understanding.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"For through wisdom","poem":1},{"noteId":33},{"text":"your days will be multiplied,","poem":1},{"text":"and years will be added to your life.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"If you are wise, you are wise to your own advantage;","poem":1},{"text":"but if you scoff, you alone will bear the consequences.","poem":2}]},{"type":"heading","content":["The Way of Folly"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"The woman named Folly is loud;","poem":1},{"text":"she is naive and knows nothing.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"She sits at the door of her house,","poem":1},{"text":"on a seat in the heights of the city,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"calling out to those who pass by,","poem":1},{"text":"who make their paths straight.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Whoever is simple, let him turn in here!”","poem":1},{"text":"she says to him who lacks judgment.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Stolen water is sweet,","poem":1},{"text":"and bread eaten in secret is tasty!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"But they do not know that the dead","poem":1},{"noteId":34},{"text":"are there,","poem":1},{"text":"that her guests are in the depths of Sheol.","poem":2}]}],"footnotes":[{"noteId":32,"text":"Hebrew; LXX, Syriac, and Aramaic Targum has set up","caller":"+","reference":{"chapter":9,"verse":1}},{"noteId":33,"text":"LXX, Syriac, and Aramaic Targum; Hebrew through me","caller":"+","reference":{"chapter":9,"verse":11}},{"noteId":34,"text":"Hebrew the Rephaim","caller":"+","reference":{"chapter":9,"verse":18}}]},"thisChapterLink":"/api/BSB/PRO/9.json","thisChapterReference":{"translationId":"BSB","book":"PRO","chapter":9},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PRO/9/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PRO/9/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PRO/9/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PRO/10.json","nextChapterReference":{"translationId":"BSB","book":"PRO","chapter":10},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PRO/10/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PRO/10/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PRO/10/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PRO/8.json","previousChapterReference":{"translationId":"BSB","book":"PRO","chapter":8},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PRO/8/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PRO/8/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PRO/8/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":18}