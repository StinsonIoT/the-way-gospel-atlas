{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PRO","name":"Proverbs","commonName":"Proverbs","title":"Proverbs","order":20,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PRO/1.json","firstChapterReference":{"translationId":"BSB","book":"PRO","chapter":1},"lastChapterNumber":31,"lastChapterApiLink":"/api/BSB/PRO/31.json","lastChapterReference":{"translationId":"BSB","book":"PRO","chapter":31},"numberOfChapters":31,"totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Avoiding Immorality"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"My son, pay attention to my wisdom;","poem":1},{"text":"incline your ear to my insight,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"that you may maintain discretion","poem":1},{"text":"and your lips may preserve knowledge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Though the lips of the forbidden woman","poem":1},{"noteId":15},{"text":"drip honey","poem":1},{"text":"and her speech","poem":2},{"noteId":16},{"text":"is smoother than oil,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"in the end she is bitter as wormwood,","poem":1},{"text":"sharp as a double-edged sword.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Her feet go down to death;","poem":1},{"text":"her steps lead straight to Sheol.","poem":2},{"noteId":17}]},{"type":"verse","number":6,"content":[{"text":"She does not consider the path of life;","poem":1},{"text":"she does not know that her ways are unstable.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"So now, my sons, listen to me,","poem":1},{"text":"and do not turn aside from the words of my mouth.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Keep your path far from her;","poem":1},{"text":"do not go near the door of her house,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"lest you concede your vigor to others,","poem":1},{"text":"and your years to one who is cruel;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"lest strangers feast on your wealth,","poem":1},{"text":"and your labors enrich the house of a foreigner.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"At the end of your life you will groan","poem":1},{"text":"when your flesh and your body are spent,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"and you will say, “How I hated discipline,","poem":1},{"text":"and my heart despised reproof!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"I did not listen to the voice of my teachers","poem":1},{"text":"or incline my ear to my mentors.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I am on the brink of utter ruin","poem":1},{"text":"in the midst of the whole assembly.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Drink water from your own cistern,","poem":1},{"text":"and running water from your own well.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Why should your springs flow in the streets,","poem":1},{"text":"your streams of water in the public squares?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Let them be yours alone,","poem":1},{"text":"never to be shared with strangers.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"May your fountain be blessed,","poem":1},{"text":"and may you rejoice in the wife of your youth:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"A loving doe, a graceful fawn—","poem":1},{"text":"may her breasts satisfy you always;","poem":2},{"text":"may you be captivated","poem":2},{"noteId":18},{"text":"by her love forever.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Why be captivated, my son, by an adulteress,","poem":1},{"text":"or embrace the bosom of a stranger?","poem":2},{"noteId":19}]},{"type":"verse","number":21,"content":[{"text":"For a man’s ways are before the eyes of the LORD,","poem":1},{"text":"and the LORD examines","poem":2},{"noteId":20},{"text":"all his paths.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"The iniquities of a wicked man entrap him;","poem":1},{"text":"the cords of his sin entangle him.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"He dies for lack of discipline,","poem":1},{"text":"led astray by his own great folly.","poem":2}]}],"footnotes":[{"noteId":15,"text":"Or the adulteress","caller":"+","reference":{"chapter":5,"verse":3}},{"noteId":16,"text":"Or her palate","caller":"+","reference":{"chapter":5,"verse":3}},{"noteId":17,"text":"Or lay hold of Sheol","caller":"+","reference":{"chapter":5,"verse":5}},{"noteId":18,"text":"Or be led astray; also in verse 20","caller":"+","reference":{"chapter":5,"verse":19}},{"noteId":19,"text":"Or a foreign woman or another man’s wife","caller":"+","reference":{"chapter":5,"verse":20}},{"noteId":20,"text":"Or ponders or makes level","caller":"+","reference":{"chapter":5,"verse":21}}]},"thisChapterLink":"/api/BSB/PRO/5.json","thisChapterReference":{"translationId":"BSB","book":"PRO","chapter":5},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PRO/5/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PRO/5/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PRO/5/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PRO/6.json","nextChapterReference":{"translationId":"BSB","book":"PRO","chapter":6},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PRO/6/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PRO/6/audio/soue