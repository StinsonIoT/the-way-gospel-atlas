{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PRO","name":"Proverbs","commonName":"Proverbs","title":"Proverbs","order":20,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PRO/1.json","firstChapterReference":{"translationId":"BSB","book":"PRO","chapter":1},"lastChapterNumber":31,"lastChapterApiLink":"/api/BSB/PRO/31.json","lastChapterReference":{"translationId":"BSB","book":"PRO","chapter":31},"numberOfChapters":31,"totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"heading","content":["The Selfishness of the Unfriendly"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"He who isolates himself pursues selfish desires;","poem":1},{"text":"he rebels against all sound judgment.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"A fool does not delight in understanding,","poem":1},{"text":"but only in airing his opinions.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"With a wicked man comes contempt as well,","poem":1},{"text":"and shame is accompanied by disgrace.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"The words of a man’s mouth are deep waters;","poem":1},{"text":"the fountain of wisdom is a bubbling brook.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Showing partiality","poem":1},{"noteId":48},{"text":"to the wicked is not good,","poem":1},{"text":"nor is depriving the innocent of justice.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"A fool’s lips bring him strife,","poem":1},{"text":"and his mouth invites a beating.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A fool’s mouth is his ruin,","poem":1},{"text":"and his lips are a snare to his soul.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"The words of a gossip are like choice morsels","poem":1},{"text":"that go down into the inmost being.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Whoever is slothful in his work","poem":1},{"text":"is brother to him who destroys.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"The name of the LORD is a strong tower;","poem":1},{"text":"the righteous run to it","poem":2},{"noteId":49},{"text":"and are safe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"A rich man’s wealth is his fortified city;","poem":1},{"text":"it is like a high wall in his imagination.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Before his downfall a man’s heart is proud,","poem":1},{"text":"but humility comes before honor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"He who answers a matter before he hears it—","poem":1},{"text":"this is folly and disgrace to him.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"The spirit of a man can endure his sickness,","poem":1},{"text":"but who can survive a broken spirit?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"The heart of the discerning acquires knowledge,","poem":1},{"text":"and the ear of the wise seeks it out.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"A man’s gift opens doors for him,","poem":1},{"text":"and brings him before great men.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"The first to state his case seems right","poem":1},{"text":"until another comes and cross-examines him.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Casting the lot ends quarrels","poem":1},{"text":"and separates strong opponents.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"An offended brother is harder to win than a fortified city,","poem":1},{"text":"and disputes are like the bars of a castle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"From the fruit of his mouth a man’s belly is filled;","poem":1},{"text":"with the harvest from his lips he is satisfied.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Life and death are in the power of the tongue,","poem":1},{"text":"and those who love it will eat its fruit.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"He who finds a wife finds a good thing","poem":1},{"text":"and obtains favor from the LORD.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"The poor man pleads for mercy,","poem":1},{"text":"but the rich man answers harshly.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"A man of many companions may come to ruin,","poem":1},{"text":"but there is a friend who stays closer than a brother.","poem":2}]}],"footnotes":[{"noteId":48,"text":"Hebrew Lifting the face","caller":"+","reference":{"chapter":18,"verse":5}},{"noteId":49,"text":"Or to Him","caller":"+","reference":{"chapter":18,"verse":10}}]},"thisChapterLink":"/api/BSB/PRO/18.json","thisChapterReference":{"translationId":"BSB","book":"PRO","chapter":18},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PRO/18/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PRO/18/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PRO/18/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PRO/19.json","nextChapterReference":{"translationId":"BSB","book":"PRO","chapter":19},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PRO/19/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PRO/19/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PRO/19/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PRO/17.json","previousChapterReference":{"translationId":"BSB","book":"PRO","chapter":17},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PRO/17/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PRO/17/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PRO/17/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":24}