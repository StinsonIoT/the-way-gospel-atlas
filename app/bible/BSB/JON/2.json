{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"JON","name":"Jonah","commonName":"Jonah","title":"Jonah","order":32,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/JON/1.json","firstChapterReference":{"translationId":"BSB","book":"JON","chapter":1},"lastChapterNumber":4,"lastChapterApiLink":"/api/BSB/JON/4.json","lastChapterReference":{"translationId":"BSB","book":"JON","chapter":4},"numberOfChapters":4,"totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Jonah’s Prayer"]},{"type":"line_break"},{"type":"verse","number":1,"content":["From inside the fish, Jonah prayed to the LORD his God,"]},{"type":"verse","number":2,"content":["saying:",{"lineBreak":true},{"text":"“In my distress I called to the LORD,","poem":1},{"text":"and He answered me.","poem":2},{"text":"From the belly of Sheol I called for help,","poem":1},{"text":"and You heard my voice.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For You cast me into the deep,","poem":1},{"text":"into the heart of the seas,","poem":2},{"text":"and the current swirled about me;","poem":1},{"text":"all Your breakers and waves swept over me.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"At this, I said,","poem":1},{"text":"‘I have been banished from Your sight;","poem":2},{"text":"yet I will look once more","poem":1},{"text":"toward Your holy temple.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"The waters engulfed me","poem":1},{"text":"to take my life;","poem":2},{"text":"the watery depths closed around me;","poem":1},{"text":"the seaweed wrapped around my head.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"To the roots of the mountains I descended;","poem":1},{"text":"the earth beneath me barred me in forever!","poem":2},{"text":"But You raised my life from the pit,","poem":1},{"text":"O LORD my God!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"As my life was fading away,","poem":1},{"text":"I remembered the LORD.","poem":2},{"text":"My prayer went up to You,","poem":1},{"text":"to Your holy temple.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Those who cling to worthless idols","poem":1},{"text":"forsake His loving devotion.","poem":2},{"noteId":1}]},{"type":"verse","number":9,"content":[{"text":"But I, with the voice of thanksgiving,","poem":1},{"text":"will sacrifice to You.","poem":2},{"text":"I will fulfill what I have vowed.","poem":1},{"text":"Salvation is from the LORD!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"And the LORD commanded the fish, and it vomited Jonah onto dry land.","poem":2}]}],"footnotes":[{"noteId":1,"text":"Forms of the Hebrew chesed are translated here and in most cases throughout the Scriptures as loving devotion; the range of meaning includes love, goodness, kindness, faithfulness, and mercy, as well as loyalty to a covenant.","caller":"+","reference":{"chapter":2,"verse":8}}]},"thisChapterLink":"/api/BSB/JON/2.json","thisChapterReference":{"translationId":"BSB","book":"JON","chapter":2},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JON/2/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JON/2/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JON/2/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/JON/3.json","nextChapterReference":{"translationId":"BSB","book":"JON","chapter":3},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JON/3/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JON/3/audio/souer.mp3",