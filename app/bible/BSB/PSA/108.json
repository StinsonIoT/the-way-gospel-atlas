{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":108,"content":[{"type":"heading","content":["Israel’s Kingdom Blessing"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A song. A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"My heart is steadfast, O God;","poem":1},{"text":"I will sing and make music with all my being.","poem":2},{"noteId":232}]},{"type":"verse","number":2,"content":[{"text":"Awake, O harp and lyre!","poem":1},{"text":"I will awaken the dawn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I will praise You, O LORD, among the nations;","poem":1},{"text":"I will sing Your praises among the peoples.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"For Your loving devotion extends beyond the heavens,","poem":1},{"text":"and Your faithfulness reaches to the clouds.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Be exalted, O God, above the heavens;","poem":1},{"text":"may Your glory cover all the earth.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Respond and save us with Your right hand,","poem":1},{"text":"that Your beloved may be delivered.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"God has spoken from His sanctuary:","poem":1},{"noteId":233},{"text":"“I will triumph!","poem":2},{"text":"I will parcel out Shechem","poem":1},{"text":"and apportion the Valley of Succoth.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gilead is Mine, and Manasseh is Mine;","poem":1},{"text":"Ephraim is My helmet, Judah is My scepter.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moab is My washbasin;","poem":1},{"text":"upon Edom I toss My sandal;","poem":2},{"text":"over Philistia I shout in triumph.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Who will bring me to the fortified city?","poem":1},{"text":"Who will lead me to Edom?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Have You not rejected us, O God?","poem":1},{"text":"Will You no longer march out, O God, with our armies?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Give us aid against the enemy,","poem":1},{"text":"for the help of man is worthless.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"With God we will perform with valor,","poem":1},{"text":"and He will trample our enemies.","poem":2}]}],"footnotes":[{"noteId":232,"text":"Or with my glory","caller":"+","reference":{"chapter":108,"verse":1}},{"noteId":233,"text":"Or in His holiness","caller":"+","reference":{"chapter":108,"verse":7}}]},"thisChapterLink":"/api/BSB/PSA/108.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":108},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/108/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/108/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/108/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/109.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":109},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/109/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/109/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/109/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/107.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":107},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/107/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/107/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/107/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":13}