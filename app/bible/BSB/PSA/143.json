{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":143,"content":[{"type":"heading","content":["I Stretch Out My Hands to You"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O LORD, hear my prayer.","poem":1},{"text":"In Your faithfulness, give ear to my plea;","poem":2},{"text":"in Your righteousness, answer me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Do not bring Your servant into judgment,","poem":1},{"text":"for no one alive is righteous before You.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"For the enemy has pursued my soul,","poem":1},{"text":"crushing my life to the ground,","poem":2},{"text":"making me dwell in darkness","poem":1},{"text":"like those long since dead.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"My spirit grows faint within me;","poem":1},{"text":"my heart is dismayed inside me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I remember the days of old;","poem":1},{"text":"I meditate on all Your works;","poem":2},{"text":"I consider the work of Your hands.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I stretch out my hands to You;","poem":1},{"text":"my soul thirsts for You like a parched land. Selah","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Answer me quickly, O LORD;","poem":1},{"text":"my spirit fails.","poem":2},{"text":"Do not hide Your face from me,","poem":1},{"text":"or I will be like those who descend to the Pit.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Let me hear Your loving devotion in the morning,","poem":1},{"text":"for I have put my trust in You.","poem":2},{"text":"Teach me the way I should walk,","poem":1},{"text":"for to You I lift up my soul.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Deliver me from my enemies, O LORD;","poem":1},{"text":"I flee to You for refuge.","poem":2},{"noteId":283}]},{"type":"verse","number":10,"content":[{"text":"Teach me to do Your will,","poem":1},{"text":"for You are my God.","poem":2},{"text":"May Your good Spirit lead me","poem":1},{"text":"on level ground.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"For the sake of Your name, O LORD,","poem":1},{"text":"revive me.","poem":2},{"text":"In Your righteousness,","poem":1},{"text":"bring my soul out of trouble.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"And in Your loving devotion,","poem":1},{"text":"cut off my enemies.","poem":2},{"text":"Destroy all who afflict me,","poem":1},{"text":"for I am Your servant.","poem":2}]}],"footnotes":[{"noteId":283,"text":"LXX and one Hebrew manuscript; most Hebrew manuscripts in You I take cover","caller":"+","reference":{"chapter":143,"verse":9}}]},"thisChapterLink":"/api/BSB/PSA/143.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":143},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/143/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/143/audio/souer.mp3","david":"https://audio.bible.helloao.or