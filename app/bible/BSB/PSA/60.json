{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":60,"content":[{"type":"heading","content":["Victory with God"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. To the tune of “The Lily of the Covenant.” A Miktam","poem":2},{"noteId":134},{"text":"of David for instruction. When he fought Aram-naharaim","poem":2},{"noteId":135},{"text":"and Aram-zobah,","poem":2},{"noteId":136},{"text":"and Joab returned and struck down 12,000 Edomites in the Valley of Salt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"You have rejected us, O God;","poem":1},{"text":"You have broken us;","poem":2},{"text":"You have been angry;","poem":1},{"text":"restore us!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"You have shaken the land","poem":1},{"text":"and torn it open.","poem":2},{"text":"Heal its fractures,","poem":1},{"text":"for it is quaking.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"You have shown Your people hardship;","poem":1},{"text":"we are staggered from the wine You made us drink.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"You have raised a banner for those who fear You,","poem":1},{"text":"that they may flee the bow.","poem":2},{"noteId":137},{"text":"Selah","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Respond and save us with Your right hand,","poem":1},{"text":"that Your beloved may be delivered.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"God has spoken from His sanctuary:","poem":1},{"noteId":138},{"text":"“I will triumph!","poem":2},{"text":"I will parcel out Shechem","poem":1},{"text":"and apportion the Valley of Succoth.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gilead is Mine, and Manasseh is Mine;","poem":1},{"text":"Ephraim is My helmet, Judah is My scepter.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moab is My washbasin;","poem":1},{"text":"upon Edom I toss My sandal;","poem":2},{"text":"over Philistia I shout in triumph.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Who will bring me to the fortified city?","poem":1},{"text":"Who will lead me to Edom?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Have You not rejected us, O God?","poem":1},{"text":"Will You no longer march out, O God, with our armies?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Give us aid against the enemy,","poem":1},{"text":"for the help of man is worthless.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"With God we will perform with valor,","poem":1},{"text":"and He will trample our enemies.","poem":2}]}],"footnotes":[{"noteId":134,"text":"Miktam is probably a musical or liturgical term; used for Psalms 16 and 56–60.","caller":"+","reference":{"chapter":60,"verse":1}},{"noteId":135,"text":"That is, Mesopotamia; Aram-naharaim means Aram of the two rivers, likely the region between the Euphrates and Balih Rivers in northwestern Mesopotamia.","caller":"+","reference":{"chapter":60,"verse":1}},{"noteId":136,"text":"That is, the land northeast of Damascus","caller":"+","reference":{"chapter":60,"verse":1}},{"noteId":137,"text":"Or that it may be displayed because of truth","caller":"+","reference":{"chapter":60,"verse":4}},{"noteId":138,"text":"Or in His holiness","caller":"+","reference":{"chapter":60,"verse":6}}]},"thisChapterLink":"/api/BSB/PSA/60.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":60},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/60/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/60/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/60/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/61.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":61},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/61/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/61/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/61/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/59.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":59},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/59/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/59/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/59/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":12}