{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":16,"content":[{"type":"heading","content":["The Presence of the LORD"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Miktam","poem":2},{"noteId":27},{"text":"of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Preserve me, O God,","poem":1},{"text":"for in You I take refuge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"I said to the LORD, “You are my Lord;","poem":1},{"text":"apart from You I have no good thing.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"As for the saints in the land,","poem":1},{"text":"they are the excellence","poem":2},{"text":"in whom all my delight resides.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sorrows will multiply","poem":1},{"text":"to those who chase other gods.","poem":2},{"text":"I will not pour out their libations of blood,","poem":1},{"text":"or speak their names with my lips.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"The LORD is my chosen portion and my cup;","poem":1},{"text":"You have made my lot secure.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The lines of my boundary have fallen in pleasant places;","poem":1},{"text":"surely my inheritance is delightful.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I will bless the LORD who counsels me;","poem":1},{"text":"even at night my conscience instructs me.","poem":2},{"noteId":28}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I have set","poem":1},{"noteId":29},{"text":"the LORD always before me.","poem":1},{"text":"Because He is at my right hand, I will not be shaken.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Therefore my heart is glad and my tongue rejoices;","poem":1},{"text":"my body also will dwell securely.","poem":2},{"noteId":30}]},{"type":"verse","number":10,"content":[{"text":"For You will not abandon my soul to Sheol,","poem":1},{"text":"nor will You let Your Holy One see decay.","poem":2},{"noteId":31}]},{"type":"verse","number":11,"content":[{"text":"You have made known to me the path of life;","poem":1},{"text":"You will fill me with joy in Your presence,","poem":2},{"noteId":32},{"text":"with eternal pleasures at Your right hand.","poem":2}]}],"footnotes":[{"noteId":27,"text":"Miktam is probably a musical or liturgical term; used for Psalm 16 and Psalms 56–60.","caller":"+","reference":{"chapter":16,"verse":1}},{"noteId":28,"text":"Or my heart instructs me; Hebrew my kidneys instruct me","caller":"+","reference":{"chapter":16,"verse":7}},{"noteId":29,"text":"LXX I foresaw","caller":"+","reference":{"chapter":16,"verse":8}},{"noteId":30,"text":"LXX will dwell in hope","caller":"+","reference":{"chapter":16,"verse":9}},{"noteId":31,"text":"Cited in Acts 13:35","caller":"+","reference":{"chapter":16,"verse":10}},{"noteId":32,"text":"Cited in Acts 2:25–28","caller":"+","reference":{"chapter":16,"verse":11}}]},"thisChapterLink":"/api/BSB/PSA/16.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":16},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.or