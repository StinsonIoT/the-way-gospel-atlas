{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":138,"content":[{"type":"heading","content":["A Thankful Heart"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"Of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I give You thanks with all my heart;","poem":1},{"text":"before the gods I sing Your praises.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I bow down toward Your holy temple","poem":1},{"text":"and give thanks to Your name","poem":2},{"text":"for Your loving devotion and Your faithfulness;","poem":2},{"text":"You have exalted Your name","poem":1},{"text":"and Your word above all else.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"On the day I called, You answered me;","poem":1},{"text":"You emboldened me and strengthened my soul.","poem":2},{"noteId":276}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"All the kings of the earth will give You thanks, O LORD,","poem":1},{"text":"when they hear the words of Your mouth.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"They will sing of the ways of the LORD,","poem":1},{"text":"for the glory of the LORD is great.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Though the LORD is on high,","poem":1},{"text":"He attends to the lowly;","poem":2},{"text":"but the proud He knows from afar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"If I walk in the midst of trouble,","poem":1},{"text":"You preserve me from the anger of my foes;","poem":2},{"text":"You extend Your hand,","poem":1},{"text":"and Your right hand saves me.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"The LORD will fulfill","poem":1},{"text":"His purpose for me.","poem":2},{"lineBreak":true},{"text":"O LORD, Your loving devotion endures forever—","poem":1},{"text":"do not abandon the works of Your hands.","poem":2}]}],"footnotes":[{"noteId":276,"text":"Or You emboldened me with strength in my soul","caller":"+","reference":{"chapter":138,"verse":3}}]},"thisChapterLink":"/api/BSB/PSA/138.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":138},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/138/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/138/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/138/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/139.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":139},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/139/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/139/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/139/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/137.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":137},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/137/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/137/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/137/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapter