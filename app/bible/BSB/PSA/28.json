{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":28,"content":[{"type":"heading","content":["The LORD Is My Strength"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"Of David.","poem":1}]},{"type":"verse","number":1,"content":[{"text":"To You, O LORD, I call;","poem":1},{"text":"be not deaf to me, O my Rock.","poem":2},{"text":"For if You remain silent,","poem":1},{"text":"I will be like those descending to the Pit.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hear my cry for mercy","poem":1},{"text":"when I call to You for help,","poem":2},{"text":"when I lift up my hands","poem":1},{"text":"toward Your holy sanctuary.","poem":2},{"noteId":58}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Do not drag me away with the wicked,","poem":1},{"text":"and with the workers of iniquity,","poem":2},{"text":"who speak peace to their neighbors","poem":1},{"text":"while malice is in their hearts.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Repay them according to their deeds","poem":1},{"text":"and for their works of evil.","poem":2},{"text":"Repay them for what their hands have done;","poem":1},{"text":"bring back on them what they deserve.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Since they show no regard for the works of the LORD","poem":1},{"text":"or what His hands have done,","poem":2},{"text":"He will tear them down","poem":1},{"text":"and never rebuild them.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Blessed be the LORD,","poem":1},{"text":"for He has heard my cry for mercy.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"The LORD is my strength and my shield;","poem":1},{"text":"my heart trusts in Him, and I am helped.","poem":2},{"text":"Therefore my heart rejoices,","poem":1},{"text":"and I give thanks to Him with my song.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"The LORD is the strength of His people,","poem":1},{"text":"a stronghold of salvation for His anointed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Save Your people and bless Your inheritance;","poem":1},{"text":"shepherd them and carry them forever.","poem":2}]}],"footnotes":[{"noteId":58,"text":"Or Your innermost sanctuary or Your Most Holy Place","caller":"+","reference":{"chapter":28,"verse":2}}]},"thisChapterLink":"/api/BSB/PSA/28.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":28},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/28/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/28/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/28/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/29.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":29},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/29/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/29/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/29/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/27.json","previousChapterReference":{"translationId":"BSB","book":"PSA"