{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":38,"content":[{"type":"heading","content":["Do Not Rebuke Me in Your Anger"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Psalm of David, for remembrance.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O LORD, do not rebuke me in Your anger","poem":1},{"text":"or discipline me in Your wrath.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"For Your arrows have pierced me deeply,","poem":1},{"text":"and Your hand has pressed down on me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"There is no soundness in my body","poem":1},{"text":"because of Your anger;","poem":2},{"text":"there is no rest in my bones","poem":1},{"text":"because of my sin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"For my iniquities have overwhelmed me;","poem":1},{"text":"they are a burden too heavy to bear.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"My wounds are foul and festering","poem":1},{"text":"because of my sinful folly.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I am bent and brought low;","poem":1},{"text":"all day long I go about mourning.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For my loins are full of burning pain,","poem":1},{"text":"and no soundness remains in my body.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I am numb and badly crushed;","poem":1},{"text":"I groan in anguish of heart.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Lord, my every desire is before You;","poem":1},{"text":"my groaning is not hidden from You.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"My heart pounds, my strength fails,","poem":1},{"text":"and even the light of my eyes has faded.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"My beloved and friends shun my disease,","poem":1},{"text":"and my kinsmen stand at a distance.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Those who seek my life lay snares;","poem":1},{"text":"those who wish me harm speak destruction,","poem":2},{"text":"plotting deceit all day long.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"But like a deaf man, I do not hear;","poem":1},{"text":"and like a mute man, I do not open my mouth.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I am like a man who cannot hear,","poem":1},{"text":"whose mouth offers no reply.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I wait for You, O LORD;","poem":1},{"text":"You will answer, O Lord my God.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"For I said, “Let them not gloat over me—","poem":1},{"text":"those who taunt me when my foot slips.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"For I am ready to fall,","poem":1},{"text":"and my pain is ever with me.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yes, I confess my iniquity;","poem":1},{"text":"I am troubled by my sin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Many are my enemies without cause,","poem":1},{"noteId":86},{"text":"and many hate me without reason.","poem":2},{"noteId":87}]},{"type":"verse","number":20,"content":[{"text":"Those who repay my good with evil","poem":1},{"text":"attack me for pursuing the good.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Do not forsake me, O LORD;","poem":1},{"text":"be not far from me, O my God.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Come quickly to help me,","poem":1},{"text":"O Lord my Savior.","poem":2}]}],"footnotes":[{"noteId":86,"text":"One DSS manuscript; MT My enemies are vigorous and strong","caller":"+","reference":{"chapter":38,"verse":19}},{"noteId":87,"text":"See John 15:25","caller":"+","reference":{"chapter":38,"verse":19}}]},"thisChapterLink":"/api/BSB/PSA/38.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":38},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/38/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/38/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/38/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/39.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":39},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/39/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/39/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/39/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/37.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":37},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/37/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/37/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/37/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":22}