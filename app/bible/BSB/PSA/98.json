{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":98,"content":[{"type":"heading","content":["Sing to the LORD a New Song"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Psalm.","poem":2},{"text":"The LORD reigns;","poem":1},{"text":"let the nations tremble!","poem":2},{"text":"He is enthroned above the cherubim;","poem":1},{"text":"let the earth quake!","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Sing to the LORD a new song,","poem":1},{"text":"for He has done wonders;","poem":2},{"text":"His right hand and holy arm","poem":1},{"text":"have gained Him the victory.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The LORD has proclaimed His salvation","poem":1},{"text":"and revealed His righteousness to the nations.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"He has remembered His love and faithfulness","poem":1},{"text":"to the house of Israel;","poem":2},{"text":"all the ends of the earth","poem":1},{"text":"have seen the salvation of our God.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Make a joyful noise to the LORD, all the earth;","poem":1},{"text":"break forth—let your cry ring out, and sing praises!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sing praises to the LORD with the lyre,","poem":1},{"text":"in melodious song with the harp.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"With trumpets and the blast of the ram’s horn","poem":1},{"text":"shout for joy before the LORD, the King.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Let the sea resound, and all that fills it,","poem":1},{"text":"the world, and all who dwell in it.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Let the rivers clap their hands,","poem":1},{"text":"let the mountains sing together for joy","poem":2}]},{"type":"verse","number":9,"content":[{"text":"before the LORD,","poem":1},{"text":"for He comes to judge the earth.","poem":2},{"text":"He will judge the world with righteousness","poem":1},{"text":"and the peoples with equity.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/BSB/PSA/98.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":98},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/98/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/98/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/98/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/99.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":99},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/99/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/99/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/99/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/97.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":97},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/97/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/97/audio/souer.mp3","david":"https://audio.bible.helloao.