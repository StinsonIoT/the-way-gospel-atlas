{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":79,"content":[{"type":"heading","content":["A Prayer for Deliverance"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Psalm of Asaph.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"The nations, O God, have invaded Your inheritance;","poem":1},{"text":"they have defiled Your holy temple","poem":2},{"text":"and reduced Jerusalem to rubble.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"They have given the corpses of Your servants","poem":1},{"text":"as food to the birds of the air,","poem":2},{"text":"the flesh of Your saints to the beasts of the earth.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"They have poured out their blood like water","poem":1},{"text":"all around Jerusalem,","poem":2},{"text":"and there is no one to bury the dead.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We have become a reproach to our neighbors,","poem":1},{"text":"a scorn and derision to those around us.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"How long, O LORD?","poem":1},{"text":"Will You be angry forever?","poem":2},{"text":"Will Your jealousy burn like fire?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pour out Your wrath on the nations","poem":1},{"text":"that do not acknowledge You,","poem":2},{"text":"on the kingdoms","poem":1},{"text":"that refuse to call on Your name,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"for they have devoured Jacob","poem":1},{"text":"and devastated his homeland.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Do not hold past sins against us;","poem":1},{"text":"let Your compassion come quickly,","poem":2},{"text":"for we are brought low.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Help us, O God of our salvation,","poem":1},{"text":"for the glory of Your name;","poem":2},{"text":"deliver us and atone for our sins,","poem":1},{"text":"for the sake of Your name.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Why should the nations ask,","poem":1},{"text":"“Where is their God?”","poem":2},{"text":"Before our eyes, make known among the nations","poem":1},{"text":"Your vengeance for the bloodshed of Your servants.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"May the groans of the captives reach You;","poem":1},{"text":"by the strength of Your arm preserve those condemned to death.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pay back into the laps of our neighbors","poem":1},{"text":"sevenfold the reproach they hurled at You, O Lord.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Then we Your people, the sheep of Your pasture,","poem":1},{"text":"will thank You forever;","poem":2},{"text":"from generation to generation","poem":1},{"text":"we will declare Your praise.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/BSB/PSA/79.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":79},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/79/audio/hays.mp3","souer":"ht