{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":58,"content":[{"type":"heading","content":["God Judges the Earth"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. To the tune of “Do Not Destroy.” A Miktam","poem":2},{"noteId":131},{"text":"of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Do you indeed speak justly, O rulers?","poem":1},{"text":"Do you judge uprightly, O sons of men?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"No, in your hearts you devise injustice;","poem":1},{"text":"with your hands you mete out violence on the earth.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"The wicked are estranged from the womb;","poem":1},{"text":"the liars go astray from birth.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Their venom is like the venom of a snake,","poem":1},{"text":"like a cobra that shuts its ears,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"refusing to hear the tune of the charmer","poem":1},{"text":"who skillfully weaves his spell.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O God, shatter their teeth in their mouths;","poem":1},{"text":"O LORD, tear out the fangs of the lions.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"May they vanish","poem":1},{"text":"like water that runs off;","poem":2},{"text":"when they draw the bow,","poem":1},{"text":"may their arrows be blunted.","poem":2},{"noteId":132}]},{"type":"verse","number":8,"content":[{"text":"Like a slug that dissolves in its slime,","poem":1},{"text":"like a woman’s stillborn child,","poem":2},{"text":"may they never see the sun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Before your pots can feel the burning thorns—","poem":1},{"text":"whether green or dry—","poem":2},{"text":"He will sweep them away.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"The righteous will rejoice","poem":1},{"text":"when they see they are avenged;","poem":2},{"text":"they will wash their feet","poem":1},{"text":"in the blood of the wicked.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Then men will say,","poem":1},{"text":"“There is surely a reward for the righteous!","poem":2},{"text":"There is surely a God who judges the earth!”","poem":2}]}],"footnotes":[{"noteId":131,"text":"Miktam is probably a musical or liturgical term; used for Psalms 16 and 56–60.","caller":"+","reference":{"chapter":58,"verse":1}},{"noteId":132,"text":"Or when they are trodden down, may they wither like grass","caller":"+","reference":{"chapter":58,"verse":7}}]},"thisChapterLink":"/api/BSB/PSA/58.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":58},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/58/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/58/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/58/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/59.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":59},"nextChapterAudioLinks":{"hays":"htt