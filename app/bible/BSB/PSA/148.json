{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":148,"content":[{"type":"heading","content":["Praise the LORD from the Heavens"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Praise Him, all His angels;","poem":1},{"text":"praise Him, all His heavenly hosts.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Praise Him, O sun and moon;","poem":1},{"text":"praise Him, all you shining stars.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Praise Him, O highest heavens,","poem":1},{"text":"and you waters above the skies.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Let them praise the name of the LORD,","poem":1},{"text":"for He gave the command and they were created.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He established them forever and ever;","poem":1},{"text":"He issued a decree that will never pass away.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Praise the LORD from the earth,","poem":1},{"text":"all great sea creatures and ocean depths,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"lightning and hail, snow and clouds,","poem":1},{"text":"powerful wind ful