{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":41,"content":[{"type":"heading","content":["Victory over Betrayal"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. A Psalm of David.","poem":2},{"text":"BOOK II Psalms 42–72","poem":1}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Blessed is the one who cares for the poor;","poem":1},{"text":"the LORD will deliver him in the day of trouble.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The LORD will protect and preserve him;","poem":1},{"text":"He will bless him in the land","poem":2},{"text":"and refuse to surrender him","poem":1},{"text":"to the will of his foes.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The LORD will sustain him on his bed of illness","poem":1},{"text":"and restore him from his bed of sickness.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I said, “O LORD, be gracious to me;","poem":1},{"text":"heal me, for I have sinned against You.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"My enemies say with malice:","poem":1},{"text":"“When will he die and be forgotten?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"My visitor speaks falsehood;","poem":1},{"text":"he gathers slander in his heart;","poem":2},{"text":"he goes out and spreads it abroad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"All who hate me whisper against me;","poem":1},{"text":"they imagine the worst for me:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“A vile disease has been poured into him;","poem":1},{"text":"he will never get up from where he lies!”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Even my close friend whom I trusted,","poem":1},{"text":"the one who shared my bread,","poem":2},{"text":"has lifted up his heel against me.","poem":2},{"noteId":91}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"But You, O LORD, be gracious to me and raise me up,","poem":1},{"text":"that I may repay them.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"By this I know that You delight in me,","poem":1},{"text":"for my enemy does not triumph over me.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"In my integrity You uphold me","poem":1},{"text":"and set me in Your presence forever.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Blessed be the LORD, the God of Israel,","poem":1},{"text":"from everlasting to everlasting.","poem":2},{"lineBreak":true},{"text":"Amen and Amen.","poem":1}]}],"footnotes":[{"noteId":91,"text":"Cited in John 13:18","caller":"+","reference":{"chapter":41,"verse":9}}]},"thisChapterLink":"/api/BSB/PSA/41.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":41},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/41/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/41/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/41/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/42.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":42},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/42/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/42/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/42/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/40.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":40},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/40/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/40/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/40/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":13}