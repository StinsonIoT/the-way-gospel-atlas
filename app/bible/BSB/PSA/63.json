{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":63,"content":[{"type":"heading","content":["Thirsting for God"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Psalm of David, when he was in the Wilderness of Judah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O God, You are my God.","poem":1},{"text":"Earnestly I seek You;","poem":2},{"text":"my soul thirsts for You.","poem":2},{"text":"My body yearns for You","poem":1},{"text":"in a dry and weary land without water.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"So I have seen You in the sanctuary","poem":1},{"text":"and beheld Your power and glory.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Because Your loving devotion is better than life,","poem":1},{"text":"my lips will glorify You.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"So I will bless You as long as I live;","poem":1},{"text":"in Your name I will lift my hands.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"My soul is satisfied as with the richest of foods;","poem":1},{"text":"with joyful lips my mouth will praise You.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"When I remember You on my bed,","poem":1},{"text":"I think of You through the watches of the night.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For You are my help;","poem":1},{"text":"I will sing for joy in the shadow of Your wings.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"My soul clings to You;","poem":1},{"text":"Your right hand upholds me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"But those who seek my life to destroy it","poem":1},{"text":"will go into the depths of the earth.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"They will fall to the power of the sword;","poem":1},{"text":"they will become a portion for foxes.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"But the king will rejoice in God;","poem":1},{"text":"all who swear by Him will exult,","poem":2},{"text":"for the mouths of liars will be shut.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/BSB/PSA/63.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":63},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/63/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/63/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/63/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/64.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":64},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/64/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/64/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/64/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/62.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":62},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/62/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/62/au