{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":96,"content":[{"type":"heading","content":["Sing to the LORD, All the Earth"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sing to the LORD, bless His name;","poem":1},{"text":"proclaim His salvation day after day.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Declare His glory among the nations,","poem":1},{"text":"His wonderful deeds among all peoples.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"For great is the LORD, and greatly to be praised;","poem":1},{"text":"He is to be feared above all gods.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For all the gods of the nations are idols,","poem":1},{"text":"but it is the LORD who made the heavens.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Splendor and majesty are before Him;","poem":1},{"text":"strength and beauty fill His sanctuary.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ascribe to the LORD, O families of the nations,","poem":1},{"text":"ascribe to the LORD glory and strength.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ascribe to the LORD the glory due His name;","poem":1},{"text":"bring an offering and enter His courts.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Worship the LORD in the splendor of His holiness;","poem":1},{"text":"tremble before Him, all the earth.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Declare among the nations: “The LORD reigns!”","poem":1},{"text":"The world is firmly established; it cannot be moved;","poem":2},{"text":"He will judge the peoples with equity.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Let the heavens be glad","poem":1},{"text":"and the earth rejoice;","poem":2},{"text":"let the sea resound,","poem":1},{"text":"and all that fills it.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Let the fields exult,","poem":1},{"text":"and all that is in them.","poem":2},{"text":"Then all the trees of the forest","poem":1},{"text":"will sing for joy","poem":2}]},{"type":"verse","number":13,"content":[{"text":"before the LORD,","poem":2},{"text":"for He is coming—","poem":1},{"text":"He is coming to judge the earth.","poem":2},{"text":"He will judge the world in righteousness","poem":1},{"text":"and the peoples in His faithfulness.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/BSB/PSA/96.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":96},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/96/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/96/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/96/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/97.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":97},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/97/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/97/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/97/audio/david.mp3"},"previousC