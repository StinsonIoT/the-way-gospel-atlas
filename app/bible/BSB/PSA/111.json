{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":111,"content":[{"type":"heading","content":["Majestic Is His Work"]},{"type":"line_break"},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Great are the works of the LORD;","poem":1},{"text":"they are pondered by all who delight in them.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Splendid and majestic is His work;","poem":1},{"text":"His righteousness endures forever.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He has caused His wonders to be remembered;","poem":1},{"text":"the LORD is gracious and compassionate.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He provides food for those who fear Him;","poem":1},{"text":"He remembers His covenant forever.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"He has shown His people the power of His works","poem":1},{"text":"by giving them the inheritance of the nations.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"The works of His hands are truth and justice;","poem":1},{"text":"all His precepts are trustworthy.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"They are upheld forever and ever,","poem":1},{"text":"enacted in truth and uprightness.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He has sent redemption to His people;","poem":1},{"text":"He has ordained His covenant forever;","poem":2},{"text":"holy and awesome is His name.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"The fear of the LORD is the beginning of wisdom;","poem":1},{"text":"all who follow His precepts gain rich understanding.","poem":2},{"lineBreak":true},{"text":"His praise endures forever!","poem":1}]}],"footnotes":[{"noteId":238,"text":"Or Hallelu YAH, meaning Praise the LORD. This psalm is an acrostic poem, each line beginning with the successive letters of the Hebrew alphabet.","caller":"+","reference":{"chapter":111,"verse":1}}]},"thisChapterLink":"/api/BSB/PSA/111.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":111},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/111/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/111/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/111/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/112.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":112},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/112/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/112/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/112/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/110.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":110},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/110/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/110/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/110/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"num