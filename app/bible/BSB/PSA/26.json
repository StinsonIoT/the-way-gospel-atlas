{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":26,"content":[{"type":"heading","content":["Vindicate Me, O LORD"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"Of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Vindicate me, O LORD!","poem":1},{"lineBreak":true},{"text":"For I have walked with integrity;","poem":1},{"text":"I have trusted in the LORD without wavering.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Test me, O LORD, and try me;","poem":1},{"text":"examine my heart","poem":2},{"noteId":57},{"text":"and mind.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For Your loving devotion is before my eyes,","poem":1},{"text":"and I have walked in Your truth.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I do not sit with deceitful men,","poem":1},{"text":"nor keep company with hypocrites.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I hate the mob of evildoers,","poem":1},{"text":"and refuse to sit with the wicked.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I wash my hands in innocence","poem":1},{"text":"that I may go about Your altar, O LORD,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"to raise my voice in thanksgiving","poem":1},{"text":"and declare all Your wonderful works.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O LORD, I love the house where You dwell,","poem":1},{"text":"the place where Your glory resides.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Do not take my soul away with sinners,","poem":1},{"text":"or my life with men of bloodshed,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"in whose hands are wicked schemes,","poem":1},{"text":"whose right hands are full of bribes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"But I will walk with integrity;","poem":1},{"text":"redeem me and be merciful to me.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"My feet stand on level ground;","poem":1},{"text":"in the congregations I will bless the LORD.","poem":2}]}],"footnotes":[{"noteId":57,"text":"Hebrew my kidneys","caller":"+","reference":{"chapter":26,"verse":2}}]},"thisChapterLink":"/api/BSB/PSA/26.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":26},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/26/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/26/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/26/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/27.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":27},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/27/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/27/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/27/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/25.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":25},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PS