{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":141,"content":[{"type":"heading","content":["Come Quickly to Me"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I call upon You, O LORD; come quickly to me.","poem":1},{"text":"Hear my voice when I call to You.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"May my prayer be set before You like incense,","poem":1},{"text":"my uplifted hands like the evening offering.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Set a guard, O LORD, over my mouth;","poem":1},{"text":"keep watch at the door of my lips.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Do not let my heart be drawn to any evil thing","poem":1},{"text":"or take part in works of wickedness","poem":2},{"text":"with men who do iniquity;","poem":1},{"text":"let me not feast on their delicacies.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Let the righteous man strike me;","poem":1},{"text":"let his rebuke be an act of loving devotion.","poem":2},{"text":"It is oil for my head; let me not refuse it.","poem":1},{"text":"For my prayer is ever against the deeds of the wicked.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"When their rulers are thrown down from the cliffs,","poem":1},{"text":"the people will listen to my words,","poem":2},{"text":"for they are pleasant.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"As when one plows and breaks up the soil,","poem":1},{"text":"so our bones have been scattered at the mouth of Sheol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"But my eyes are fixed on You,","poem":1},{"text":"O GOD the Lord.","poem":2},{"text":"In You I seek refuge;","poem":1},{"text":"do not leave my soul defenseless.","poem":2},{"noteId":281}]},{"type":"verse","number":9,"content":[{"text":"Keep me from the snares they have laid for me,","poem":1},{"text":"and from the lures of evildoers.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Let the wicked fall into their own nets,","poem":1},{"text":"while I pass by in safety.","poem":2}]}],"footnotes":[{"noteId":281,"text":"Or do not pour out my life or do not give me over to death","caller":"+","reference":{"chapter":141,"verse":8}}]},"thisChapterLink":"/api/BSB/PSA/141.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":141},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/141/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/141/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/141/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/142.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":142},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/142/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/142/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/142/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/140.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":140},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/140/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/140/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/140/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":10}