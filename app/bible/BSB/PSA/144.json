{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":144,"content":[{"type":"heading","content":["Blessed Be the LORD, My Rock"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"Of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Blessed be the LORD, my Rock,","poem":1},{"text":"who trains my hands for war,","poem":2},{"text":"my fingers for battle.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He is my steadfast love and my fortress,","poem":1},{"text":"my stronghold and my deliverer.","poem":2},{"text":"He is my shield, in whom I take refuge,","poem":1},{"text":"who subdues peoples","poem":2},{"noteId":284},{"text":"under me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O LORD, what is man, that You regard him,","poem":1},{"text":"the son of man that You think of him?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Man is like a breath;","poem":1},{"text":"his days are like a passing shadow.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Part Your heavens, O LORD, and come down;","poem":1},{"text":"touch the mountains, that they may smoke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Flash forth Your lightning and scatter them;","poem":1},{"text":"shoot Your arrows and rout them.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Reach down from on high;","poem":1},{"text":"set me free and rescue me","poem":2},{"text":"from the deep waters,","poem":1},{"text":"from the grasp of foreigners,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"whose mouths speak falsehood,","poem":1},{"text":"whose right hands are deceitful.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I will sing to You a new song, O God;","poem":1},{"text":"on a harp of ten strings I will make music to You—","poem":2}]},{"type":"verse","number":10,"content":[{"text":"to Him who gives victory to kings,","poem":1},{"text":"who frees His servant David from the deadly sword.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Set me free and rescue me","poem":1},{"text":"from the grasp of foreigners,","poem":2},{"text":"whose mouths speak falsehood,","poem":1},{"text":"whose right hands are deceitful.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Then our sons will be like plants","poem":1},{"text":"nurtured in their youth,","poem":2},{"text":"our daughters like corner pillars","poem":1},{"text":"carved to adorn a palace.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Our storehouses will be full,","poem":1},{"text":"supplying all manner of produce;","poem":2},{"text":"our flocks will bring forth thousands,","poem":1},{"text":"tens of thousands in our fields.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Our oxen will bear great loads.","poem":1},{"noteId":285},{"text":"There will be no breach in the walls,","poem":2},{"text":"no going into captivity,","poem":1},{"text":"and no cry of lament in our streets.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Blessed are the people of whom this is so;","poem":1},{"text":"blessed are the people whose God is the LORD.","poem":2}]}],"footnotes":[{"noteId":284,"text":"Many Hebrew manuscripts, DSS, Syriac; most Hebrew manuscripts subdues my people","caller":"+","reference":{"chapter":144,"verse":2}},{"noteId":285,"text":"Or Our chieftains will be firmly established","caller":"+","reference":{"chapter":144,"verse":14}}]},"thisChapterLink":"/api/BSB/PSA/144.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":144},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/144/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/144/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/144/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/145.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":145},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/145/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/145/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/145/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/143.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":143},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/143/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/143/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/143/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":15}