{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":85,"content":[{"type":"heading","content":["You Showed Favor to Your Land"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. A Psalm of the sons of Korah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"You showed favor to Your land, O LORD;","poem":1},{"text":"You restored Jacob from captivity.","poem":2},{"noteId":188}]},{"type":"verse","number":2,"content":[{"text":"You forgave the iniquity of Your people;","poem":1},{"text":"You covered all their sin. Selah","poem":2}]},{"type":"verse","number":3,"content":[{"text":"You withheld all Your fury;","poem":1},{"text":"You turned from Your burning anger.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Restore us, O God of our salvation,","poem":1},{"text":"and put away Your displeasure toward us.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Will You be angry with us forever?","poem":1},{"text":"Will You draw out Your anger to all generations?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Will You not revive us again,","poem":1},{"text":"that Your people may rejoice in You?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Show us Your loving devotion, O LORD,","poem":1},{"text":"and grant us Your salvation.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I will listen to what God the LORD will say;","poem":1},{"text":"for He will surely speak peace to His people and His saints;","poem":2},{"text":"He will not let them return to folly.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Surely His salvation is near to those who fear Him,","poem":1},{"text":"that His glory may dwell in our land.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Loving devotion and faithfulness have joined together;","poem":1},{"text":"righteousness and peace have kissed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Faithfulness sprouts from the earth,","poem":1},{"text":"and righteousness looks down from heaven.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"The LORD will indeed provide what is good,","poem":1},{"text":"and our land will yield its increase.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Righteousness will go before Him","poem":1},{"text":"to prepare the way for His steps.","poem":2}]}],"footnotes":[{"noteId":188,"text":"Or restored the fortunes of Jacob","caller":"+","reference":{"chapter":85,"verse":1}}]},"thisChapterLink":"/api/BSB/PSA/85.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":85},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/85/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/85/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/85/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/86.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":86},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/86/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PS