{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":5,"content":[{"type":"heading","content":["Give Ear to My Words"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster, to be accompanied by flutes. A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Give ear to my words, O LORD;","poem":1},{"text":"consider my groaning.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Attend to the sound of my cry,","poem":1},{"text":"my King and my God,","poem":2},{"text":"for to You I pray.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"In the morning, O LORD, You hear my voice;","poem":1},{"text":"at daybreak I lay my plea before You","poem":2},{"text":"and wait in expectation.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"For You are not a God who delights in wickedness;","poem":1},{"text":"no evil can dwell with You.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The boastful cannot stand in Your presence;","poem":1},{"text":"You hate all workers of iniquity.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You destroy those who tell lies;","poem":1},{"text":"the LORD abhors the man of bloodshed and deceit.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"But I will enter Your house","poem":1},{"text":"by the abundance of Your loving devotion;","poem":2},{"noteId":8},{"text":"in reverence I will bow down","poem":1},{"text":"toward Your holy temple.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lead me, O LORD, in Your righteousness","poem":1},{"text":"because of my enemies;","poem":2},{"text":"make straight Your way before me.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"For not a word they speak can be trusted;","poem":1},{"text":"destruction lies within them.","poem":2},{"text":"Their throats are open graves;","poem":1},{"text":"their tongues practice deceit.","poem":2},{"noteId":9}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Declare them guilty, O God;","poem":1},{"text":"let them fall by their own devices.","poem":2},{"text":"Drive them out for their many transgressions,","poem":1},{"text":"for they have rebelled against You.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"But let all who take refuge in You rejoice;","poem":1},{"text":"let them ever shout for joy.","poem":2},{"text":"May You shelter them,","poem":1},{"text":"that those who love Your name may rejoice in You.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"For surely You, O LORD, bless the righteous;","poem":1},{"text":"You surround them with the shield of Your favor.","poem":2}]}],"footnotes":[{"noteId":8,"text":"Forms of the Hebrew chesed are translated here and in most cases throughout the Scriptures as loving devotion; the range of meaning includes love, goodness, kindness, faithfulness, and mercy, as well as loyalty to a covenant.","caller":"+","reference":{"chapter":5,"verse":7}},{"noteId":9,"text":"Or flattery; cited in Romans 3:13","caller":"+","reference":{"chapter":5,"verse":9}}]},"thisChapterLink":"/api/BSB/PSA/5.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":5},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/5/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/5/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/5/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/6.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":6},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/6/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/6/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/6/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/4.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":4},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/4/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/4/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/4/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":12}