{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":94,"content":[{"type":"heading","content":["The LORD Will Not Forget His People"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rise up, O Judge of the earth;","poem":1},{"text":"render a reward to the proud.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"How long will the wicked, O LORD,","poem":1},{"text":"how long will the wicked exult?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"They pour out arrogant words;","poem":1},{"text":"all workers of iniquity boast.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"They crush Your people, O LORD;","poem":1},{"text":"they oppress Your heritage.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"They kill the widow and the foreigner;","poem":1},{"text":"they murder the fatherless.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"They say, “The LORD does not see;","poem":1},{"text":"the God of Jacob pays no heed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Take notice, O senseless among the people!","poem":1},{"text":"O fools, when will you be wise?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He who affixed the ear, can He not hear?","poem":1},{"text":"He who formed the eye, can He not see?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"He who admonishes the nations, does He not discipline?","poem":1},{"text":"He who teaches man, does He lack knowledge?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"The LORD knows the thoughts of man,","poem":1},{"text":"that they are futile.","poem":2},{"noteId":202}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Blessed is the man You discipline, O LORD,","poem":1},{"text":"and teach from Your law,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"to grant him relief from days of trouble,","poem":1},{"text":"until a pit is dug for the wicked.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"For the LORD will not forsake His people;","poem":1},{"text":"He will never abandon His heritage.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Surely judgment will again be righteous,","poem":1},{"text":"and all the upright in heart will follow it.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Who will rise up for me against the wicked?","poem":1},{"text":"Who will stand for me against the workers of iniquity?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unless the LORD had been my helper,","poem":1},{"text":"I would soon have dwelt in the abode of silence.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"If I say, “My foot is slipping,”","poem":1},{"text":"Your loving devotion, O LORD, supports me.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"When anxiety overwhelms me,","poem":1},{"text":"Your consolation delights my soul.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Can a corrupt throne be Your ally—","poem":1},{"text":"one devising mischief by decree?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"They band together against the righteous","poem":1},{"text":"and condemn the innocent to death.","poem":2},{"noteId":203}]},{"type":"verse","number":22,"content":[{"text":"But the LORD has been my stronghold,","poem":1},{"text":"and my God is my rock of refuge.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"He will bring upon them their own iniquity","poem":1},{"text":"and destroy them for their wickedness.","poem":2},{"text":"The LORD our God will destroy them.","poem":2}]}],"footnotes":[{"noteId":202,"text":"Cited in 1 Corinthians 3:20","caller":"+","reference":{"chapter":94,"verse":11}},{"noteId":203,"text":"Or condemn innocent blood","caller":"+","reference":{"chapter":94,"verse":21}}]},"thisChapterLink":"/api/BSB/PSA/94.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":94},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/94/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/94/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/94/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/95.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":95},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/95/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/95/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/95/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/93.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":93},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/93/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/93/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/93/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":22}