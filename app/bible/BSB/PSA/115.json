{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":115,"content":[{"type":"heading","content":["To Your Name Be the Glory"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Why should the nations say,","poem":1},{"text":"“Where is their God?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Our God is in heaven;","poem":1},{"text":"He does as He pleases.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Their idols are silver and gold,","poem":1},{"text":"made by the hands of men.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"They have mouths, but cannot speak;","poem":1},{"text":"they have eyes, but cannot see;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"they have ears, but cannot hear;","poem":1},{"text":"they have noses, but cannot smell;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"they have hands, but cannot feel;","poem":1},{"text":"they have feet, but cannot walk;","poem":2},{"text":"they cannot even clear their throats.","poem":2},{"noteId":242}]},{"type":"verse","number":8,"content":[{"text":"Those who make them become like them,","poem":1},{"text":"as do all who trust in them.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Israel,","poem":1},{"noteId":243},{"text":"trust in the LORD!","poem":1},{"text":"He is their help and shield.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"O house of Aaron, trust in the LORD!","poem":1},{"text":"He is their help and shield.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"You who fear the LORD, trust in the LORD!","poem":1},{"text":"He is their help and shield.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"The LORD is mindful of us;","poem":1},{"text":"He will bless us.","poem":2},{"text":"He will bless the house of Israel;","poem":1},{"text":"He will bless the house of Aaron;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"He will bless those who fear the LORD—","poem":1},{"text":"small and great alike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"May the LORD give you increase,","poem":1},{"text":"both you and your children.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"May you be blessed by the LORD,","poem":1},{"text":"the Maker of heaven and earth.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"The highest heavens belong to the LORD,","poem":1},{"text":"but the earth He has given to mankind.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"It is not the dead who praise the LORD,","poem":1},{"text":"nor any who descend into silence.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"But it is we who will bless the LORD,","poem":1},{"text":"both now and forevermore.","poem":2},{"lineBreak":true},{"text":"Hallelujah!","poem":1},{"noteId":244}]}],"footnotes":[{"noteId":242,"text":"Literally they cannot utter with their throat","caller":"+","reference":{"chapter":115,"verse":7}},{"noteId":243,"text":"MT; many Hebrew manuscripts, LXX, and Syriac O house of Israel","caller":"+","reference":{"chapter":115,"verse":9}},{"noteId":244,"text":"Or Hallelu YAH, meaning Praise the LORD","caller":"+","reference":{"chapter":115,"verse":18}}]},"thisChapterLink":"/api/BSB/PSA/115.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":115},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/115/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/115/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/115/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/116.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":116},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/116/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/116/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/116/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/114.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":114},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/114/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/114/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/114/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":17}