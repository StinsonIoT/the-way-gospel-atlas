{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":8,"content":[{"type":"heading","content":["How Majestic Is Your Name!"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. According to Gittith.","poem":2},{"noteId":14},{"text":"A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O LORD, our Lord,","poem":1},{"text":"how majestic is Your name in all the earth!","poem":2},{"lineBreak":true},{"text":"You have set Your glory","poem":1},{"text":"above the heavens.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"From the mouths of children and infants","poem":1},{"text":"You have ordained praise","poem":2},{"noteId":15},{"text":"on account of Your adversaries,","poem":1},{"text":"to silence the enemy and avenger.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"When I behold Your heavens,","poem":1},{"text":"the work of Your fingers,","poem":2},{"text":"the moon and the stars,","poem":1},{"text":"which You have set in place—","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"what is man that You are mindful of him,","poem":1},{"text":"or the son of man that You care for him?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"You made him a little lower than the angels;","poem":1},{"noteId":16},{"text":"You crowned him with glory and honor.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You made him ruler of the works of Your hands;","poem":1},{"text":"You have placed everything under his feet:","poem":2},{"noteId":17}]},{"type":"verse","number":7,"content":[{"text":"all sheep and oxen,","poem":1},{"text":"and even the beasts of the field,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"the birds of the air and the fish of the sea,","poem":1},{"text":"all that swim the paths of the seas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O LORD, our Lord,","poem":1},{"text":"how majestic is Your name in all the earth!","poem":2}]}],"footnotes":[{"noteId":14,"text":"Gittith is probably a musical or liturgical term; here and in Psalms 81 and 84.","caller":"+","reference":{"chapter":8,"verse":1}},{"noteId":15,"text":"Literally You have ordained strength; LXX You have prepared praise; cited in Matthew 21:16","caller":"+","reference":{"chapter":8,"verse":2}},{"noteId":16,"text":"Or than God or than the heavenly beings; see also LXX.","caller":"+","reference":{"chapter":8,"verse":5}},{"noteId":17,"text":"Cited in 1 Corinthians 15:27 and Hebrews 2:6–8","caller":"+","reference":{"chapter":8,"verse":6}}]},"thisChapterLink":"/api/BSB/PSA/8.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":8},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/8/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/8/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/8/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/9.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":9},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/9/audio/hays.mp3","souer"