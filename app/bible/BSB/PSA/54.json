{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":54,"content":[{"type":"heading","content":["Save Me by Your Name"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. With stringed instruments. A Maskil","poem":2},{"noteId":123},{"text":"of David. When the Ziphites went to Saul and said, “Is David not hiding among us?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Save me, O God, by Your name,","poem":1},{"text":"and vindicate me by Your might!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hear my prayer, O God;","poem":1},{"text":"listen to the words of my mouth.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For strangers rise up against me,","poem":1},{"text":"and ruthless men seek my life—","poem":2},{"text":"men with no regard for God. Selah","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Surely God is my helper;","poem":1},{"text":"the Lord is the sustainer of my soul.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He will reward my enemies with evil.","poem":1},{"text":"In Your faithfulness, destroy them.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Freely I will s