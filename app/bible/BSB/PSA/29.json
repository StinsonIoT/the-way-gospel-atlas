{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":29,"content":[{"type":"heading","content":["Ascribe Glory to the LORD"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Ascribe to the LORD, O heavenly beings,","poem":1},{"noteId":59},{"text":"ascribe to the LORD glory and strength.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ascribe to the LORD the glory due His name;","poem":1},{"text":"worship the LORD in the splendor of His holiness.","poem":2},{"noteId":60}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"The voice of the LORD is over the waters;","poem":1},{"text":"the God of glory thunders;","poem":2},{"text":"the LORD is heard over many waters.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The voice of the LORD is powerful;","poem":1},{"text":"the voice of the LORD is majestic.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The voice of the LORD breaks the cedars;","poem":1},{"text":"the LORD shatters the cedars of Lebanon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He makes Lebanon skip like a calf,","poem":1},{"text":"and Sirion","poem":2},{"noteId":61},{"text":"like a young wild ox.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"The voice of the LORD","poem":1},{"text":"strikes with flames of fire.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"The voice of the LORD shakes the wilderness;","poem":1},{"text":"the LORD shakes the Wilderness of Kadesh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The voice of the LORD twists the oaks","poem":1},{"noteId":62},{"text":"and strips the forests bare.","poem":2},{"text":"And in His temple all cry, “Glory!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"The LORD sits enthroned over the flood;","poem":1},{"text":"the LORD is enthroned as King forever.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"The LORD gives His people strength;","poem":1},{"text":"the LORD blesses His people with peace.","poem":2}]}],"footnotes":[{"noteId":59,"text":"Or sons of God or sons of might","caller":"+","reference":{"chapter":29,"verse":1}},{"noteId":60,"text":"Or in holy attire","caller":"+","reference":{"chapter":29,"verse":2}},{"noteId":61,"text":"That is, Mount Hermon","caller":"+","reference":{"chapter":29,"verse":6}},{"noteId":62,"text":"Or LORD makes the deer to calve","caller":"+","reference":{"chapter":29,"verse":9}}]},"thisChapterLink":"/api/BSB/PSA/29.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":29},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/29/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/29/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/29/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/30.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":30},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/30/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/B