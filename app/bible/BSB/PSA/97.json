{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":97,"content":[{"type":"heading","content":["Let the Earth Rejoice"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Clouds and darkness surround Him;","poem":1},{"text":"righteousness and justice are His throne’s foundation.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Fire goes before Him","poem":1},{"text":"and consumes His foes on every side.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"His lightning illuminates the world;","poem":1},{"text":"the earth sees and trembles.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The mountains melt like wax","poem":1},{"text":"at the presence of the LORD,","poem":2},{"text":"before the Lord of all the earth.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The heavens proclaim His righteousness;","poem":1},{"text":"all the peoples see His glory.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"All worshipers of images are put to shame—","poem":1},{"text":"those who boast in idols.","poem":2},{"text":"Worship Him, all you gods!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zion hears and rejoices,","poem":1},{"text":"and the towns of Judah exult","poem":2},{"text":"because of Your judgments, O LORD.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"For You, O LORD, are Most High over all the earth;","poem":1},{"text":"You are exalted far above all gods.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hate evil, O you who love the LORD!","poem":1},{"text":"He preserves the souls of His saints;","poem":2},{"text":"He delivers them from the hand of the wicked.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Light shines","poem":1},{"noteId":208},{"text":"on the righteous,","poem":1},{"text":"gladness on the upright in heart.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Rejoice in the LORD, you righteous ones,","poem":1},{"text":"and praise His holy name.","poem":2}]}],"footnotes":[{"noteId":208,"text":"One Hebrew manuscript, LXX, Syriac, and Vulgate; most Hebrew manuscripts Light is sown","caller":"+","reference":{"chapter":97,"verse":11}}]},"thisChapterLink":"/api/BSB/PSA/97.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":97},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/97/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/97/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/97/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/98.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":98},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/98/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/98/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/98/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/96.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":96},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/96/audio/hays.mp3","souer"