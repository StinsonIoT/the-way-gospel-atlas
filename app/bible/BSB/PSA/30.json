{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":30,"content":[{"type":"heading","content":["You Turned My Mourning into Dancing"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Psalm. A song for the dedication of the temple. Of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I will exalt You, O LORD,","poem":1},{"text":"for You have lifted me up","poem":2},{"text":"and have not allowed my foes","poem":1},{"text":"to rejoice over me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O LORD my God, I cried to You for help,","poem":1},{"text":"and You healed me.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O LORD, You pulled me up from Sheol;","poem":1},{"text":"You spared me from descending into the Pit.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sing to the LORD, O you His saints,","poem":1},{"text":"and praise His holy name.","poem":2},{"noteId":63}]},{"type":"verse","number":5,"content":[{"text":"For His anger is fleeting,","poem":1},{"text":"but His favor lasts a lifetime.","poem":2},{"text":"Weeping may stay the night,","poem":1},{"text":"but joy comes in the morning.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"In prosperity I said,","poem":1},{"text":"“I will never be shaken.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O LORD, You favored me;","poem":1},{"text":"You made my mountain stand strong.","poem":2},{"lineBreak":true},{"text":"When You hid Your face,","poem":1},{"text":"I was dismayed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"To You, O LORD, I called,","poem":1},{"text":"and I begged my Lord for mercy:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“What gain is there in my bloodshed,","poem":1},{"noteId":64},{"text":"in my descent to the Pit?","poem":2},{"noteId":65},{"text":"Will the dust praise You?","poem":1},{"text":"Will it proclaim Your faithfulness?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hear me, O LORD, and have mercy;","poem":1},{"text":"O LORD, be my helper.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"You turned my mourning into dancing;","poem":1},{"text":"You peeled off my sackcloth and clothed me with joy,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"that my heart may sing Your praises and not be silent.","poem":1},{"text":"O LORD my God, I will give thanks forever.","poem":2}]}],"footnotes":[{"noteId":63,"text":"Or and praise the memorial of His holiness; see Exodus 3:15.","caller":"+","reference":{"chapter":30,"verse":4}},{"noteId":64,"text":"Or in my destruction","caller":"+","reference":{"chapter":30,"verse":9}},{"noteId":65,"text":"Or to corruption","caller":"+","reference":{"chapter":30,"verse":9}}]},"thisChapterLink":"/api/BSB/PSA/30.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":30},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/30/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/30/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/30/audio/david.mp3"},