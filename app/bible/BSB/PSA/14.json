{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":14,"content":[{"type":"heading","content":["The Fool Says There Is No God"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. Of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"The fool","poem":1},{"noteId":24},{"text":"says in his heart,","poem":1},{"text":"“There is no God.”","poem":2},{"lineBreak":true},{"text":"They are corrupt; their acts are vile.","poem":1},{"text":"There is no one who does good.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"The LORD looks down from heaven","poem":1},{"text":"upon the sons of men","poem":2},{"text":"to see if any understand,","poem":1},{"text":"if any seek God.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"All have turned away,","poem":1},{"text":"they have together become corrupt;","poem":2},{"noteId":25},{"text":"there is no one who does good,","poem":1},{"text":"not even one.","poem":2},{"noteId":26}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Will the workers of iniquity never learn?","poem":1},{"lineBreak":true},{"text":"They devour my people like bread;","poem":1},{"text":"they refuse to call upon the LORD.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"There they are, overwhelmed with dread,","poem":1},{"text":"for God is in the company of the righteous.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You sinners frustrate the plans of the oppressed,","poem":1},{"text":"yet the LORD is their shelter.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Oh, that the salvation of Israel would come from Zion!","poem":1},{"lineBreak":true},{"text":"When the LORD restores His captive people,","poem":1},{"text":"let Jacob rejoice, let Israel be glad!","poem":2}]}],"footnotes":[{"noteId":24,"text":"The Hebrew words rendered fool throughout the Psalms denote one who is morally deficient.","caller":"+","reference":{"chapter":14,"verse":1}},{"noteId":25,"text":"LXX worthless","caller":"+","reference":{"chapter":14,"verse":3}},{"noteId":26,"text":"Cited in Romans 3:10–12","caller":"+","reference":{"chapter":14,"verse":3}}]},"thisChapterLink":"/api/BSB/PSA/14.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":14},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/14/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/14/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/14/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/15.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":15},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/15/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/15/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/15/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/13.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":13},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/13/audio/hays.mp3","souer":"https://audio.bible.hel