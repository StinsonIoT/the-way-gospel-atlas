{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":19,"content":[{"type":"heading","content":["The Heavens Declare the Glory of God"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"The heavens declare the glory of God;","poem":1},{"text":"the skies proclaim the work of His hands.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Day after day they pour forth speech;","poem":1},{"text":"night after night they reveal knowledge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Without speech or language,","poem":1},{"text":"without a sound to be heard,","poem":2},{"noteId":40}]},{"type":"verse","number":4,"content":[{"text":"their voice","poem":1},{"noteId":41},{"text":"has gone out into all the earth,","poem":1},{"text":"their words to the ends of the world.","poem":2},{"noteId":42},{"lineBreak":true},{"text":"In the heavens He has pitched","poem":1},{"text":"a tent for the sun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Like a bridegroom emerging from his chamber,","poem":1},{"text":"like a champion rejoicing to run his course,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"it rises at one end of the heavens","poem":1},{"text":"and runs its circuit to the other;","poem":2},{"text":"nothing is deprived of its warmth.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"The Law of the LORD is perfect,","poem":1},{"text":"reviving the soul;","poem":2},{"text":"the testimony of the LORD is trustworthy,","poem":1},{"text":"making wise the simple.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"The precepts of the LORD are right,","poem":1},{"text":"bringing joy to the heart;","poem":2},{"text":"the commandments of the LORD are radiant,","poem":1},{"text":"giving light to the eyes.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The fear of the LORD is pure,","poem":1},{"text":"enduring forever;","poem":2},{"text":"the judgments of the LORD are true,","poem":1},{"text":"being altogether righteous.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"They are more precious than gold,","poem":1},{"text":"than much pure gold;","poem":2},{"text":"they are sweeter than honey,","poem":1},{"text":"than honey from the comb.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"By them indeed Your servant is warned;","poem":1},{"text":"in keeping them is great reward.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Who can discern his own errors?","poem":1},{"text":"Cleanse me from my hidden faults.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Keep Your servant also from willful sins;","poem":1},{"text":"may they not rule over me.","poem":2},{"text":"Then I will be blameless","poem":1},{"text":"and cleansed of great transgression.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"May the words of my mouth","poem":1},{"text":"and the meditation of my heart","poem":2},{"text":"be pleasing in Your sight,","poem":1},{"text":"O LORD, my Rock and my Redeemer.","poem":2}]}],"footnotes":[{"noteId":40,"text":"Or There is no speech or language where their voice is not heard","caller":"+","reference":{"chapter":19,"verse":3}},{"noteId":41,"text":"LXX, Syriac, and Vulgate; Hebrew their measuring line","caller":"+","reference":{"chapter":19,"verse":4}},{"noteId":42,"text":"Cited in Romans 10:18","caller":"+","reference":{"chapter":19,"verse":4}}]},"thisChapterLink":"/api/BSB/PSA/19.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":19},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/19/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/19/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/19/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/20.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":20},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/20/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/20/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/20/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/18.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":18},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/18/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/18/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/18/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":14}