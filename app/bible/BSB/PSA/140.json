{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":140,"content":[{"type":"heading","content":["Rescue Me from Evil Men"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Rescue me, O LORD, from evil men.","poem":1},{"text":"Protect me from men of violence,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"who devise evil in their hearts","poem":1},{"text":"and stir up war all day long.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"They sharpen their tongues like snakes;","poem":1},{"text":"the venom of vipers is on their lips.","poem":2},{"noteId":280},{"text":"Selah","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Guard me, O LORD,","poem":1},{"text":"from the hands of the wicked.","poem":2},{"text":"Keep me safe from men of violence","poem":1},{"text":"who scheme to make me stumble.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The proud hide a snare for me;","poem":1},{"text":"the cords of their net are spread along the path,","poem":2},{"text":"and lures are set out for me. Selah","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I say to the LORD, “You are my God.”","poem":1},{"text":"Hear, O LORD, my cry for help.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O GOD the Lord, the strength of my salvation,","poem":1},{"text":"You shield my head in the day of battle.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Grant not, O LORD, the desires of the wicked;","poem":1},{"text":"do not promote their evil plans,","poem":2},{"text":"lest they be exalted. Selah","poem":2}]},{"type":"verse","number":9,"content":[{"text":"May the heads of those who surround me","poem":1},{"text":"be covered in the trouble their lips have caused.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"May burning coals fall on them;","poem":1},{"text":"may they be thrown into the fire,","poem":2},{"text":"into the miry pits, never to rise again.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"May no slanderer be established in the land;","poem":1},{"text":"may calamity hunt down the man of violence.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"I know that the LORD upholds justice for the poor","poem":1},{"text":"and defends the cause of the needy.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Surely the righteous will praise Your name;","poem":1},{"text":"the upright will dwell in Your presence.","poem":2}]}],"footnotes":[{"noteId":280,"text":"Cited in Romans 3:13","caller":"+","reference":{"chapter":140,"verse":3}}]},"thisChapterLink":"/api/BSB/PSA/140.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":140},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/140/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/140/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/140/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/141.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":141},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/141/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/141/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/141/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/139.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":139},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/139/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/139/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/139/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":13}