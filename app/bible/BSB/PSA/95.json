{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":95,"content":[{"type":"heading","content":["Do Not Harden Your Hearts"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Let us enter His presence with thanksgiving;","poem":1},{"text":"let us make a joyful noise to Him in song.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"For the LORD is a great God,","poem":1},{"text":"a great King above all gods.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"In His hand are the depths of the earth,","poem":1},{"text":"and the mountain peaks belong to Him.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The sea is His, for He made it,","poem":1},{"text":"and His hands formed the dry land.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O come, let us worship and bow down;","poem":1},{"text":"let us kneel before the LORD our Maker.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For He is our God,","poem":1},{"text":"and we are the people of His pasture,","poem":2},{"text":"the sheep under His care.","poem":2},{"lineBreak":true},{"text":"Today, if you hear His voice,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"do not harden your hearts","poem":2},{"text":"as you did at Meribah,","poem":1},{"noteId":204},{"text":"in the day at Massah in the wilderness,","poem":2},{"noteId":205}]},{"type":"verse","number":9,"content":[{"text":"where your fathers tested and tried Me,","poem":1},{"text":"though they had seen My work.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"For forty years I was angry with that generation,","poem":1},{"text":"and I said, “They are a people whose hearts go astray,","poem":2},{"noteId":206},{"text":"and they have not known My ways.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"So I swore on oath in My anger,","poem":1},{"text":"“They shall never enter My rest.”","poem":2},{"noteId":207}]}],"footnotes":[{"noteId":204,"text":"LXX as you did in the rebellion; Meribah means quarreling; see Exodus 17:7; cited in Hebrews 3:15 and Hebrews 4:7.","caller":"+","reference":{"chapter":95,"verse":8}},{"noteId":205,"text":"LXX in the day of testing in the wilderness; Massah means testing; see Exodus 17:7.","caller":"+","reference":{"chapter":95,"verse":8}},{"noteId":206,"text":"LXX They always go astray in the heart","caller":"+","reference":{"chapter":95,"verse":10}},{"noteId":207,"text":"Cited in Hebrews 3:7–11, Hebrews 4:3, and Hebrews 4:5","caller":"+","reference":{"chapter":95,"verse":11}}]},"thisChapterLink":"/api/BSB/PSA/95.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":95},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/95/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/95/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/95/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/96.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":96},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/96/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/96/aud