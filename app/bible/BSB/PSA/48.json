{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":48,"content":[{"type":"heading","content":["Broken Bondage"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A song. A Psalm of the sons of Korah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Great is the LORD,","poem":1},{"text":"and greatly to be praised","poem":2},{"text":"in the city of our God,","poem":1},{"text":"His holy mountain.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Beautiful in loftiness,","poem":1},{"text":"the joy of all the earth,","poem":2},{"text":"like the peaks of Zaphon","poem":1},{"noteId":105},{"text":"is Mount Zion,","poem":1},{"text":"the city of the great King.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"God is in her citadels;","poem":1},{"text":"He has shown Himself to be a fortress.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"For behold, the kings assembled;","poem":1},{"text":"they all advanced together.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"They saw and were astounded;","poem":1},{"text":"they fled in terror.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Trembling seized them there,","poem":1},{"text":"anguish like a woman in labor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"With a wind from the east","poem":1},{"text":"You wrecked the ships of Tarshish.","poem":2},{"noteId":106}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"As we have heard, so we have seen","poem":1},{"text":"in the city of the LORD of Hosts,","poem":2},{"text":"in the city of our God:","poem":1},{"text":"God will establish her forever. Selah","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Within Your temple, O God,","poem":1},{"text":"we contemplate Your loving devotion.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Your name, O God, like Your praise,","poem":1},{"text":"reaches to the ends of the earth;","poem":2},{"text":"Your right hand is full of righteousness.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mount Zion is glad,","poem":1},{"text":"the daughters","poem":2},{"noteId":107},{"text":"of Judah rejoice,","poem":2},{"text":"on account of Your judgments.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"March around Zion, encircle her,","poem":1},{"text":"count her towers,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"consider her ramparts, tour her citadels,","poem":1},{"text":"that you may tell the next generation.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"For this God is our God forever and ever;","poem":1},{"text":"He will be our guide even till death.","poem":2},{"noteId":108}]}],"footnotes":[{"noteId":105,"text":"Or in the far north; the most sacred mountain of the Canaanites was Zaphon","caller":"+","reference":{"chapter":48,"verse":2}},{"noteId":106,"text":"Or a fleet of trading ships","caller":"+","reference":{"chapter":48,"verse":7}},{"noteId":107,"text":"Or the villages","caller":"+","reference":{"chapter":48,"verse":11}},{"noteId":108,"text":"Or He will guide us beyond death","caller":"+","