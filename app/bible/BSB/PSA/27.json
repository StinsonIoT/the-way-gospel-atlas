{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":27,"content":[{"type":"heading","content":["The LORD Is My Salvation"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"Of David.","poem":2}]},{"type":"verse","number":1,"content":[{"text":"The LORD is my light and my salvation—","poem":1},{"text":"whom shall I fear?","poem":2},{"text":"The LORD is the stronghold of my life—","poem":1},{"text":"whom shall I dread?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"When the wicked came upon me to devour my flesh,","poem":1},{"text":"my enemies and foes stumbled and fell.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Though an army encamps around me,","poem":1},{"text":"my heart will not fear;","poem":2},{"text":"though a war breaks out against me,","poem":1},{"text":"I will keep my trust.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"One thing I have asked of the LORD;","poem":1},{"text":"this is what I desire:","poem":2},{"text":"to dwell in the house of the LORD","poem":1},{"text":"all the days of my life,","poem":2},{"text":"to gaze on the beauty of the LORD","poem":1},{"text":"and seek Him in His temple.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"For in the day of trouble","poem":1},{"text":"He will hide me in His shelter;","poem":2},{"text":"He will conceal me under the cover of His tent;","poem":1},{"text":"He will set me high upon a rock.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Then my head will be held high","poem":1},{"text":"above my enemies around me.","poem":2},{"text":"At His tabernacle I will offer sacrifices with shouts of joy;","poem":1},{"text":"I will sing and make music to the LORD.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hear, O LORD, my voice when I call;","poem":1},{"text":"be merciful and answer me.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"My heart said, “Seek His face.”","poem":1},{"text":"Your face, O LORD, I will seek.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hide not Your face from me,","poem":1},{"text":"nor turn away Your servant in anger.","poem":2},{"text":"You have been my helper;","poem":1},{"text":"do not leave me or forsake me,","poem":2},{"text":"O God of my salvation.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Though my father and mother forsake me,","poem":1},{"text":"the LORD will receive me.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Teach me Your way, O LORD,","poem":1},{"text":"and lead me on a level path,","poem":2},{"text":"because of my oppressors.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Do not hand me over to the will of my foes,","poem":1},{"text":"for false witnesses rise up against me,","poem":2},{"text":"breathing out violence.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Still I am certain to see","poem":1},{"text":"the goodness of the LORD","poem":2},{"text":"in the land of the living.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wait patiently for the LORD;","poem":1},{"text":"be strong and courageous.","poem":2},{"lineBreak":true},{"text":"Wait patiently for the LORD!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/BSB/PSA/27.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":27},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/27/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/27/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/27/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/28.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":28},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/28/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/28/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/28/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/26.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":26},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/26/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/26/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/26/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":14}