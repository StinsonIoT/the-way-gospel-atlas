{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":53,"content":[{"type":"heading","content":["The Fool Says There Is No God"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. According to Mahalath.","poem":2},{"noteId":118},{"text":"A Maskil","poem":2},{"noteId":119},{"text":"of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"The fool says in his heart,","poem":1},{"text":"“There is no God.”","poem":2},{"lineBreak":true},{"text":"They are corrupt; their ways are vile.","poem":1},{"text":"There is no one who does good.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"God looks down from heaven","poem":1},{"text":"upon the sons of men","poem":2},{"text":"to see if any understand,","poem":1},{"text":"if any seek God.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"All have turned away,","poem":1},{"text":"they have together become corrupt;","poem":2},{"noteId":120},{"text":"there is no one who does good,","poem":1},{"text":"not even one.","poem":2},{"noteId":121}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Will the workers of iniquity never learn?","poem":1},{"lineBreak":true},{"text":"They devour my people like bread;","poem":1},{"text":"they refuse to call upon God.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"There they are, overwhelmed with dread,","poem":1},{"text":"where there was nothing to fear.","poem":2},{"text":"For God has scattered the bones","poem":1},{"text":"of those who besieged you.","poem":2},{"text":"You put them to shame,","poem":1},{"text":"for God has despised them.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oh, that the salvation of Israel would come from Zion!","poem":1},{"lineBreak":true},{"text":"When God restores His captive people,","poem":1},{"noteId":122},{"text":"let Jacob rejoice, let Israel be glad!","poem":2}]}],"footnotes":[{"noteId":118,"text":"Mahalath is probably a musical or liturgical term; see also Psalm 88:1.","caller":"+","reference":{"chapter":53,"verse":1}},{"noteId":119,"text":"Maskil is probably a musical or liturgical term; used for Psalms 32, 42, 44–45, 52–55, 74, 78, 88–89, and 142.","caller":"+","reference":{"chapter":53,"verse":1}},{"noteId":120,"text":"LXX worthless","caller":"+","reference":{"chapter":53,"verse":3}},{"noteId":121,"text":"Cited in Romans 3:10–12","caller":"+","reference":{"chapter":53,"verse":3}},{"noteId":122,"text":"Or the fortunes of His people","caller":"+","reference":{"chapter":53,"verse":6}}]},"thisChapterLink":"/api/BSB/PSA/53.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":53},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/53/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/53/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/53/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/54.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":54},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/54/audio/hays.mp3","souer":"https://audio.bible.helloao.org/ap