{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":4,"content":[{"type":"heading","content":["Answer Me When I Call!"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. With stringed instruments. A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Answer me when I call,","poem":1},{"text":"O God of my righteousness!","poem":2},{"text":"You have relieved my distress;","poem":1},{"text":"show me grace and hear my prayer.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"How long, O men, will my honor be maligned?","poem":1},{"text":"How long will you love vanity and seek after lies","poem":2},{"noteId":6},{"text":"? Selah","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Know that the LORD has set apart the godly for Himself;","poem":1},{"text":"the LORD hears when I call to Him.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Be angry, yet do not sin;","poem":1},{"noteId":7},{"text":"on your bed, search your heart and be still. Selah","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Offer the sacrifices of the righteous","poem":1},{"text":"and