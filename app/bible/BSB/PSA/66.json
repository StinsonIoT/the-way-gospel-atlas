{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":66,"content":[{"type":"heading","content":["Make a Joyful Noise"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. A song. A Psalm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Make a joyful noise to God,","poem":1},{"text":"all the earth!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sing the glory of His name;","poem":1},{"text":"make His praise glorious.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Say to God, “How awesome are Your deeds!","poem":1},{"text":"So great is Your power","poem":2},{"text":"that Your enemies cower before You.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"All the earth bows down to You;","poem":1},{"text":"they sing praise to You;","poem":2},{"text":"they sing praise to Your name.” Selah","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Come and see the works of God;","poem":1},{"text":"how awesome are His deeds toward mankind.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He turned the sea into dry land;","poem":1},{"text":"they passed through the waters on foot;","poem":2},{"text":"there we rejoiced in Him.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He rules forever by His power;","poem":1},{"text":"His eyes watch the nations.","poem":2},{"text":"Do not let the rebellious exalt themselves. Selah","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bless our God, O peoples;","poem":1},{"text":"let the sound of His praise be heard.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He preserves our lives","poem":1},{"text":"and keeps our feet from slipping.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"For You, O God, have tested us;","poem":1},{"text":"You have refined us like silver.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"You led us into the net;","poem":1},{"text":"You laid burdens on our backs.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"You let men ride over our heads;","poem":1},{"text":"we went through fire and water,","poem":2},{"text":"but You brought us into abundance.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"I will enter Your house with burnt offerings;","poem":1},{"text":"I will fulfill my vows to You—","poem":2}]},{"type":"verse","number":14,"content":[{"text":"the vows that my lips promised","poem":1},{"text":"and my mouth spoke in my distress.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I will offer You fatlings as burnt offerings,","poem":1},{"text":"with the fragrant smoke of rams;","poem":2},{"text":"I will offer bulls and goats. Selah","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Come and listen, all you who fear God,","poem":1},{"text":"and I will declare what He has done for me.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I cried out to Him with my mouth","poem":1},{"text":"and praised Him with my tongue.","poem":2},{"noteId":143}]},{"type":"verse","number":18,"content":[{"text":"If I had cherished iniquity in my heart,","poem":1},{"text":"the Lord would not have listened.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"But God has surely heard;","poem":1},{"text":"He has attended to the sound of my prayer.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Blessed be God, who has not rejected my prayer","poem":1},{"text":"or withheld from me His loving devotion!","poem":2}]}],"footnotes":[{"noteId":143,"text":"Or and His praise was on my tongue","caller":"+","reference":{"chapter":66,"verse":17}}]},"thisChapterLink":"/api/BSB/PSA/66.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":66},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/66/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/66/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/66/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/67.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":67},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/67/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/67/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/67/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/65.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":65},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/65/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/65/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/65/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":20}