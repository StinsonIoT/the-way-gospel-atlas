{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":112,"content":[{"type":"heading","content":["The Blessed Fear of the LORD"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"His descendants will be mighty in the land;","poem":1},{"text":"the generation of the upright will be blessed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wealth and riches are in his house,","poem":1},{"text":"and his righteousness endures forever.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Light dawns in the darkness for the upright—","poem":1},{"text":"for the gracious, compassionate, and righteous.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"It is well with the man who is generous and lends freely,","poem":1},{"text":"whose affairs are guided by justice.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Surely he will never be shaken;","poem":1},{"text":"the righteous man will be remembered forever.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He does not fear bad news;","poem":1},{"text":"his heart is steadfast, trusting in the LORD.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"His heart is assured; he does not fear,","poem":1},{"text":"until he looks in triumph on his foes.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He has scattered abroad his gifts to the poor;","poem":1},{"text":"his righteousness endures forever;","poem":2},{"noteId":240},{"text":"his horn will be lifted high in honor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"The wicked man will see and be grieved;","poem":1},{"text":"he will gnash his teeth and waste away;","poem":2},{"text":"the desires of the wicked will perish.","poem":2}]}],"footnotes":[{"noteId":239,"text":"Or Hallelu YAH, meaning Praise the LORD. This psalm is an acrostic poem, each line beginning with the successive letters of the Hebrew alphabet.","caller":"+","reference":{"chapter":112,"verse":1}},{"noteId":240,"text":"Cited in 2 Corinthians 9:9","caller":"+","reference":{"chapter":112,"verse":9}}]},"thisChapterLink":"/api/BSB/PSA/112.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":112},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/112/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/112/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/112/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/113.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":113},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/113/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/113/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/113/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/111.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":111},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/111/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/111/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/