{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":32,"content":[{"type":"heading","content":["The Joy of Forgiveness"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"Of David. A Maskil.","poem":2},{"noteId":68},{"text":"Rejoice in the LORD, O righteous ones;","poem":1},{"text":"it is fitting for the upright to praise Him.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Blessed is he whose transgressions are forgiven,","poem":1},{"text":"whose sins are covered.","poem":2},{"noteId":69}]},{"type":"verse","number":2,"content":[{"text":"Blessed is the man","poem":1},{"text":"whose iniquity the LORD does not count against him,","poem":2},{"noteId":70},{"text":"in whose spirit there is no deceit.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"When I kept silent, my bones became brittle","poem":1},{"text":"from my groaning all day long.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"For day and night","poem":1},{"text":"Your hand was heavy upon me;","poem":2},{"text":"my strength was drained","poem":1},{"noteId":71},{"text":"as in the summer heat. Selah","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Then I acknowledged my sin to You","poem":1},{"text":"and did not hide my iniquity.","poem":2},{"text":"I said, “I will confess my transgressions to the LORD,”","poem":1},{"text":"and You forgave the guilt of my sin. Selah","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Therefore let all the godly pray to You","poem":1},{"text":"while You may be found.","poem":2},{"text":"Surely when great waters rise,","poem":1},{"text":"they will not come near.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"You are my hiding place.","poem":1},{"text":"You protect me from trouble;","poem":2},{"text":"You surround me with songs of deliverance. Selah","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I will instruct you and teach you the way you should go;","poem":1},{"text":"I will give you counsel and watch over you.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Do not be like the horse or mule,","poem":1},{"text":"which have no understanding;","poem":2},{"text":"they must be controlled with bit and bridle","poem":1},{"text":"to make them come to you.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Many are the sorrows of the wicked,","poem":1},{"text":"but loving devotion surrounds him who trusts in the LORD.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Be glad in the LORD and rejoice, O righteous ones;","poem":1},{"text":"shout for joy, all you upright in heart.","poem":2}]}],"footnotes":[{"noteId":68,"text":"Maskil is probably a musical or liturgical term; used for Psalms 32, 42, 44–45, 52–55, 74, 78, 88–89, and 142.","caller":"+","reference":{"chapter":32,"verse":1}},{"noteId":69,"text":"LXX Blessed is he whose lawless acts are forgiven, whose sins are covered; cited in Romans 4:7","caller":"+","reference":{"chapter":32,"verse":1}},{"noteId":70,"text":"LXX Blessed is the man whose sin the LORD does not count against him; cited in Romans 4:8","caller":"+","reference":{"chapter":32,"verse":2}},{"noteId":71,"text":"Or my vitality was turned","caller":"+","reference":{"chapter":32,"verse":4}}]},"thisChapterLink":"/api/BSB/PSA/32.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":32},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/32/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/32/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/32/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/33.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":33},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/33/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/33/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/33/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/31.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":31},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/31/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/31/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/31/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":11}