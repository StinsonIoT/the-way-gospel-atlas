{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":116,"content":[{"type":"heading","content":["The LORD Has Heard My Voice"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Because He has inclined His ear to me,","poem":1},{"text":"I will call on Him as long as I live.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"The ropes of death entangled me;","poem":1},{"text":"the anguish of Sheol overcame me;","poem":2},{"text":"I was confronted by trouble and sorrow.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Then I called on the name of the LORD:","poem":1},{"text":"“O LORD, deliver my soul!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"The LORD is gracious and righteous;","poem":1},{"text":"our God is full of compassion.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The LORD preserves the simplehearted;","poem":1},{"text":"I was helpless, and He saved me.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Return to your rest, O my soul,","poem":1},{"text":"for the LORD has been good to you.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"For You have delivered my soul from death,","poem":1},{"text":"my eyes from tears, my feet from stumbling.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I will walk before the LORD","poem":1},{"text":"in the land of the living.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I believed, therefore I said,","poem":1},{"noteId":245},{"text":"“I am greatly afflicted.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"In my alarm I said,","poem":1},{"text":"“All men are liars!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"How can I repay the LORD","poem":1},{"text":"for all His goodness to me?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"I will lift the cup of salvation","poem":1},{"text":"and call on the name of the LORD.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I will fulfill my vows to the LORD","poem":1},{"text":"in the presence of all His people.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Precious in the sight of the LORD","poem":1},{"text":"is the death of His saints.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Truly, O LORD, I am Your servant;","poem":1},{"text":"I am Your servant, the son of Your maidservant;","poem":2},{"text":"You have broken my bonds.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"I will offer to You a sacrifice of thanksgiving","poem":1},{"text":"and call on the name of the LORD.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I will fulfill my vows to the LORD","poem":1},{"text":"in the presence of all His people,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"in the courts of the LORD’s house,","poem":1},{"text":"in your midst, O Jerusalem.","poem":2},{"lineBreak":true},{"text":"Hallelujah!","poem":1},{"noteId":246}]}],"footnotes":[{"noteId":245,"text":"LXX therefore I have spoken; cited in 2 Corinthians 4:13","caller":"+","reference":{"chapter":116,"verse":10}},{"noteId":246,"text":"Or Hallelu YAH, meaning Praise the LORD","caller":"+","reference":{"chapter":116,"verse":19}}]},"thisChapterLink":"/api/BSB/PSA/116.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":116},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/116/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/116/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/116/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/117.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":117},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/117/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/117/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/117/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/115.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":115},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/115/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/115/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/115/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":18}