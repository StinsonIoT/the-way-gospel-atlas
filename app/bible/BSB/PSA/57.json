{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":57,"content":[{"type":"heading","content":["In You My Soul Takes Refuge"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. To the tune of “Do Not Destroy.” A Miktam","poem":2},{"noteId":128},{"text":"of David, when he fled from Saul into the cave.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Have mercy on me, O God, have mercy,","poem":1},{"text":"for in You my soul takes refuge.","poem":2},{"text":"In the shadow of Your wings I will take shelter","poem":1},{"text":"until the danger has passed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I cry out to God Most High,","poem":1},{"noteId":129},{"text":"to God who fulfills His purpose for me.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"He reaches down from heaven and saves me;","poem":1},{"text":"He rebukes those who trample me. Selah","poem":2},{"text":"God sends forth","poem":1},{"text":"His loving devotion and His truth.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"My soul is among the lions;","poem":1},{"text":"I lie down with ravenous beasts—","poem":2},{"text":"with men whose teeth are spears and arrows,","poem":1},{"text":"whose tongues are sharp swords.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Be exalted, O God, above the heavens;","poem":1},{"text":"may Your glory cover all the earth.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"They spread a net for my feet;","poem":1},{"text":"my soul was despondent.","poem":2},{"text":"They dug a pit before me,","poem":1},{"text":"but they themselves have fallen into it! Selah","poem":2}]},{"type":"verse","number":7,"content":[{"text":"My heart is steadfast, O God, my heart is steadfast.","poem":1},{"text":"I will sing and make music.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awake, my glory!","poem":1},{"noteId":130},{"text":"Awake, O harp and lyre!","poem":2},{"text":"I will awaken the dawn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I will praise You, O Lord, among the nations;","poem":1},{"text":"I will sing Your praises among the peoples.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"For Your loving devotion reaches to the heavens,","poem":1},{"text":"and Your faithfulness to the clouds.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be exalted, O God, above the heavens;","poem":1},{"text":"may Your glory cover all the earth.","poem":2}]}],"footnotes":[{"noteId":128,"text":"Miktam is probably a musical or liturgical term; used for Psalms 16 and 56–60.","caller":"+","reference":{"chapter":57,"verse":1}},{"noteId":129,"text":"Hebrew Elohim-Elyon","caller":"+","reference":{"chapter":57,"verse":2}},{"noteId":130,"text":"Or Awake, my soul!","caller":"+","reference":{"chapter":57,"verse":8}}]},"thisChapterLink":"/api/BSB/PSA/57.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":57},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/57/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/57/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/57/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/58.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":58},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/58/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/58/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/58/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/56.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":56},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/56/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/56/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/56/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":11}