{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":75,"content":[{"type":"heading","content":["God’s Righteous Judgment"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster: To the tune of “Do Not Destroy.” A Psalm of Asaph. A song.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"We give thanks to You, O God;","poem":1},{"text":"we give thanks, for Your Name is near.","poem":2},{"text":"The people declare Your wondrous works.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“When I choose a time,","poem":1},{"text":"I will judge fairly.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"When the earth and all its dwellers quake,","poem":1},{"text":"it is I who bear up its pillars. Selah","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I say to the proud, ‘Do not boast,’","poem":1},{"text":"and to the wicked, ‘Do not lift up your horn.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Do not lift up your horn against heaven","poem":1},{"text":"or speak with an outstretched neck.’”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"For exaltation comes neither from east nor west,","poem":1},{"text":"nor out of the desert,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"but it is God who judges;","poem":1},{"text":"He brings down one and exalts another.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"For a cup is in the hand of the LORD,","poem":1},{"text":"full of foaming wine mixed with spices.","poem":2},{"text":"He pours from His cup,","poem":1},{"text":"and all the wicked of the earth","poem":2},{"text":"drink it down to the dregs.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"But I will proclaim Him","poem":1},{"noteId":165},{"text":"forever;","poem":1},{"text":"I will sing praise to the God of Jacob.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“All the horns of the wicked I will cut off,","poem":1},{"text":"but the horns of the righteous will be exalted.”","poem":2}]}],"footnotes":[{"noteId":165,"text":"Or proclaim it","caller":"+","reference":{"chapter":75,"verse":9}}]},"thisChapterLink":"/api/BSB/PSA/75.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":75},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/75/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/75/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/75/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/76.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":76},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/76/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/76/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/76/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/74.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":74},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/74/audio/hays.mp3","souer":"https: