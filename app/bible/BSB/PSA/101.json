{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":101,"content":[{"type":"heading","content":["I Will Set No Worthless Thing before My Eyes"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A Psalm of David.","poem":2}]},{"type":"verse","number":1,"content":[{"text":"I will sing of Your loving devotion and justice;","poem":1},{"text":"to You, O LORD, I will sing praises.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"I will ponder the way that is blameless—","poem":1},{"text":"when will You come to me?","poem":2},{"text":"I will walk in my house","poem":1},{"text":"with integrity of heart.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I will set no worthless thing","poem":1},{"text":"before my eyes.","poem":2},{"text":"I hate the work of those who fall away;","poem":1},{"text":"it shall not cling to me.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A perverse heart shall depart from me;","poem":1},{"text":"I will know nothing of evil.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Whoever slanders his neighbor in secret,","poem":1},{"text":"I will put to silence;","poem":2},{"text":"the one with