{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":20,"content":[{"type":"heading","content":["The Day of Trouble"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"May the LORD answer you in the day of trouble;","poem":1},{"text":"may the name of the God of Jacob protect you.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"May He send you help from the sanctuary","poem":1},{"text":"and sustain you from Zion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"May He remember all your gifts","poem":1},{"text":"and look favorably on your burnt offerings. Selah","poem":2}]},{"type":"verse","number":4,"content":[{"text":"May He give you the desires of your heart","poem":1},{"text":"and make all your plans succeed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"May we shout for joy at your victory","poem":1},{"text":"and raise a banner in the name of our God.","poem":2},{"text":"May the LORD grant all your petitions.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Now I know that the LORD saves His anointed;","poem":1},{"text":"He answers him from His holy heaven","poem":2},{"text":"with the saving power of His right hand.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Some trust in chariots and others in horses,","poem":1},{"text":"but we trust in the name of the LORD our God.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"They collapse and fall,","poem":1},{"text":"but we rise up and stand firm.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O LORD, save","poem":1},{"noteId":43},{"text":"the king.","poem":1},{"text":"Answer us on the day we call.","poem":2}]}],"footnotes":[{"noteId":43,"text":"Or give victory to","caller":"+","reference":{"chapter":20,"verse":9}}]},"thisChapterLink":"/api/BSB/PSA/20.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":20},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/20/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/20/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/20/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/21.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":21},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/21/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/21/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/21/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/19.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":19},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/19/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/19/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/19/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":9}