{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":21,"content":[{"type":"heading","content":["After the Battle"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O LORD, the king rejoices in Your strength.","poem":1},{"text":"How greatly he exults in Your salvation!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"You have granted his heart’s desire","poem":1},{"text":"and have not withheld the request of his lips. Selah","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For You welcomed him with rich blessings;","poem":1},{"text":"You placed on his head a crown of pure gold.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He asked You for life, and You granted it—","poem":1},{"text":"length of days, forever and ever.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Great is his glory in Your salvation;","poem":1},{"text":"You bestow on him splendor and majesty.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"For You grant him blessings forever;","poem":1},{"text":"You cheer him with joy in Your presence.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For the king trusts in the LORD;","poem":1},{"text":"through the loving devotion of the Most High,","poem":2},{"text":"he will not be shaken.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Your hand will apprehend all Your enemies;","poem":1},{"text":"Your right hand will seize those who hate You.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"You will place them in a fiery furnace","poem":1},{"text":"at the time of Your appearing.","poem":2},{"lineBreak":true},{"text":"In His wrath the LORD will engulf them,","poem":1},{"text":"and the fire will consume them.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"You will wipe their descendants from the earth,","poem":1},{"text":"and their offspring from the sons of men.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Though they intend You harm,","poem":1},{"text":"the schemes they devise will not prevail.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"For You will put them to flight","poem":1},{"text":"when Your bow is trained upon them.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Be exalted, O LORD, in Your strength;","poem":1},{"text":"we will sing and praise Your power.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/BSB/PSA/21.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":21},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/21/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/21/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/21/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/22.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":22},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/22/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/22/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/22/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/20.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":20},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/20/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/20/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/20/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":13}