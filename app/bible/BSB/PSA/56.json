{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":56,"content":[{"type":"heading","content":["Be Merciful to Me, O God"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. To the tune of “A Dove on Distant Oaks.” A Miktam","poem":1},{"noteId":125},{"text":"of David, when the Philistines seized him in Gath.","poem":1}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Be merciful to me, O God,","poem":1},{"text":"for men are hounding me;","poem":2},{"text":"all day they press their attack.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"My enemies pursue me all day long,","poem":1},{"text":"for many proudly assail me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"When I am afraid,","poem":1},{"text":"I put my trust in You.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"In God, whose word I praise—","poem":1},{"text":"in God I trust.","poem":2},{"text":"I will not be afraid.","poem":1},{"text":"What can man do to me?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"All day long they twist my words;","poem":1},{"text":"all their thoughts are on my demise.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"They conspire, they lurk,","poem":1},{"text":"they watch my steps","poem":2},{"text":"while they wait to take my life.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"In spite of such sin, will they escape?","poem":1},{"noteId":126},{"text":"In Your anger, O God, cast down the nations.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"You have taken account of my wanderings.","poem":1},{"noteId":127},{"text":"Put my tears in Your bottle—","poem":2},{"text":"are they not in Your book?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Then my enemies will retreat","poem":1},{"text":"on the day I cry for help.","poem":2},{"text":"By this I will know that God is on my side.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"In God, whose word I praise,","poem":1},{"text":"in the LORD, whose word I praise,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"in God I trust; I will not be afraid.","poem":1},{"text":"What can man do to me?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Your vows are upon me, O God;","poem":1},{"text":"I will render thank offerings to You.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"For You have delivered my soul from death,","poem":1},{"text":"and my feet from stumbling,","poem":2},{"text":"that I may walk before God","poem":1},{"text":"in the light of life.","poem":2}]}],"footnotes":[{"noteId":125,"text":"Miktam is probably a musical or liturgical term; used for Psalms 16 and 56–60.","caller":"+","reference":{"chapter":56,"verse":1}},{"noteId":126,"text":"Or do not let them escape; MT does not include do not.","caller":"+","reference":{"chapter":56,"verse":7}},{"noteId":127,"text":"Or sorrows","caller":"+","reference":{"chapter":56,"verse":8}}]},"thisChapterLink":"/api/BSB/PSA/56.json","thisChapterReference":{"translationId":"BSB","book":"PSA",