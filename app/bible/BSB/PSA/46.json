{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":46,"content":[{"type":"heading","content":["God Is Our Refuge and Strength"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. Of the sons of Korah. According to Alamoth.","poem":2},{"noteId":102},{"text":"A song.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"God is our refuge and strength,","poem":1},{"text":"an ever-present help in times of trouble.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Therefore we will not fear,","poem":1},{"text":"though the earth is transformed","poem":2},{"text":"and the mountains are toppled","poem":1},{"text":"into the depths of the seas,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"though their waters roar and foam","poem":1},{"text":"and the mountains quake in the surge. Selah","poem":2}]},{"type":"verse","number":4,"content":[{"text":"There is a river whose streams delight the city of God,","poem":1},{"text":"the holy place where the Most High dwells.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God is within her; she will not be moved.","poem":1},{"text":"God will help her when morning dawns.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nations rage, kingdoms crumble;","poem":1},{"text":"the earth melts when He lifts His voice.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"The LORD of Hosts is with us;","poem":1},{"text":"the God of Jacob is our fortress. Selah","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Come, see the works of the LORD,","poem":1},{"text":"who brings devastation upon the earth.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He makes wars to cease throughout the earth;","poem":1},{"text":"He breaks the bow and shatters the spear;","poem":2},{"text":"He burns the shields","poem":2},{"noteId":103},{"text":"in the fire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Be still and know that I am God;","poem":1},{"text":"I will be exalted among the nations,","poem":2},{"text":"I will be exalted over the earth.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"The LORD of Hosts is with us;","poem":1},{"text":"the God of Jacob is our fortress. Selah","poem":2}]}],"footnotes":[{"noteId":102,"text":"Alamoth is probably a musical or liturgical term; here and in 1 Chronicles 15:20.","caller":"+","reference":{"chapter":46,"verse":1}},{"noteId":103,"text":"Or chariots","caller":"+","reference":{"chapter":46,"verse":9}}]},"thisChapterLink":"/api/BSB/PSA/46.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":46},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/46/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/46/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/46/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/47.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":47},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/47/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/47/audio