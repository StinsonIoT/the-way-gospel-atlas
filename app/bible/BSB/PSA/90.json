{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":90,"content":[{"type":"heading","content":["From Everlasting to Everlasting"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A prayer of Moses the man of God.","poem":1},{"text":"He who dwells in the shelter of the Most High","poem":1},{"text":"will abide in the shadow of the Almighty.","poem":2},{"noteId":199}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Lord, You have been our dwelling place","poem":1},{"text":"through all generations.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Before the mountains were born","poem":1},{"text":"or You brought forth the earth and the world,","poem":2},{"text":"from everlasting to everlasting","poem":1},{"text":"You are God.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"You return man to dust,","poem":1},{"text":"saying, “Return, O sons of mortals.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"For in Your sight a thousand years","poem":1},{"text":"are but a day that passes,","poem":2},{"noteId":197},{"text":"or a watch of the night.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"You whisk them away in their sleep;","poem":1},{"text":"they are like the new grass of the morning—","poem":2}]},{"type":"verse","number":6,"content":[{"text":"in the morning it springs up new,","poem":1},{"text":"but by evening it fades and withers.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"For we are consumed by Your anger","poem":1},{"text":"and terrified by Your wrath.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"You have set our iniquities before You,","poem":1},{"text":"our secret sins in the light of Your presence.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"For all our days decline in Your fury;","poem":1},{"text":"we finish our years with a sigh.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"The length of our days is seventy years—","poem":1},{"text":"or eighty if we are strong—","poem":2},{"text":"yet their pride is but labor and sorrow,","poem":1},{"text":"for they quickly pass, and we fly away.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Who knows the power of Your anger?","poem":1},{"text":"Your wrath matches the fear You are due.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"So teach us to number our days,","poem":1},{"text":"that we may present a heart of wisdom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Return, O LORD! How long will it be?","poem":1},{"text":"Have compassion on Your servants.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Satisfy us in the morning with Your loving devotion,","poem":1},{"text":"that we may sing for joy and be glad all our days.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Make us glad for as many days as You have afflicted us,","poem":1},{"text":"for as many years as we have seen evil.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"May Your work be shown to Your servants,","poem":1},{"text":"and Your splendor to their children.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"May the favor","poem":1},{"noteId":198},{"text":"of the Lord our God rest upon us;","poem":1},{"text":"establish for us the work of our hands—","poem":2},{"text":"yes, establish the work of our hands!","poem":2}]}],"footnotes":[{"noteId":197,"text":"See 2 Peter 3:8.","caller":"+","reference":{"chapter":90,"verse":4}},{"noteId":198,"text":"Or beauty","caller":"+","reference":{"chapter":90,"verse":17}}]},"thisChapterLink":"/api/BSB/PSA/90.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":90},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/90/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/90/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/90/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/91.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":91},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/91/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/91/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/91/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/89.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":89},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/89/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/89/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/89/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":17}