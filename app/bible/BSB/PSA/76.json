{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":76,"content":[{"type":"heading","content":["God’s Name Is Great in Israel"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. With stringed instruments. A Psalm of Asaph. A song.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"God is known in Judah;","poem":1},{"text":"His name is great in Israel.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"His tent is in Salem,","poem":1},{"noteId":166},{"text":"His dwelling place in Zion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"There He shattered the flaming arrows,","poem":1},{"text":"the shield and sword and weapons of war. Selah","poem":2}]},{"type":"verse","number":4,"content":[{"text":"You are resplendent with light,","poem":1},{"text":"more majestic than mountains filled with game.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The valiant lie plundered; they sleep their last sleep.","poem":1},{"text":"No men of might could lift a hand.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"At Your rebuke, O God of Jacob,","poem":1},{"text":"both horse and rider lie stunned.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"You alone are to be feared.","poem":1},{"text":"When You are angry, who can stand before You?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"From heaven You pronounced judgment,","poem":1},{"text":"and the earth feared and was still","poem":2}]},{"type":"verse","number":9,"content":[{"text":"when God rose up to judge,","poem":1},{"text":"to save all the lowly of the earth. Selah","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Even the wrath of man shall praise You;","poem":1},{"text":"with the survivors of wrath You will clothe Yourself.","poem":2},{"noteId":167}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Make and fulfill your vows to the LORD your God;","poem":1},{"text":"let all the neighboring lands bring tribute","poem":2},{"text":"to Him who is to be feared.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"He breaks the spirits of princes;","poem":1},{"text":"He is feared by the kings of the earth.","poem":2}]}],"footnotes":[{"noteId":166,"text":"That is, Jerusalem","caller":"+","reference":{"chapter":76,"verse":2}},{"noteId":167,"text":"Or Surely Your wrath against men brings You praise, and the survivors of Your wrath will be restrained.","caller":"+","reference":{"chapter":76,"verse":10}}]},"thisChapterLink":"/api/BSB/PSA/76.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":76},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/76/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/76/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/76/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/77.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":77},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/77/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/77/audio/souer.mp3","david":"ht