{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":62,"content":[{"type":"heading","content":["Waiting on God"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. According to Jeduthun. A Psalm of David.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"In God alone my soul finds rest;","poem":1},{"text":"my salvation comes from Him.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He alone is my rock and my salvation.","poem":1},{"text":"He is my fortress;","poem":2},{"text":"I will never be shaken.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"How long will you threaten a man?","poem":1},{"text":"Will all of you throw him down","poem":2},{"text":"like a leaning wall","poem":1},{"text":"or a tottering fence?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"They fully intend to cast him down from his lofty perch;","poem":1},{"text":"they delight in lies;","poem":2},{"text":"with their mouths they bless,","poem":1},{"text":"but inwardly they curse. Selah","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rest in God alone, O my soul,","poem":1},{"text":"for my hope comes from Him.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He alone is my rock and my salvation;","poem":1},{"text":"He is my fortress; I will not be shaken.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"My salvation and my honor rest on God, my strong rock;","poem":1},{"text":"my refuge is in God.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Trust in Him at all times, O people;","poem":1},{"text":"pour out your hearts before Him.","poem":2},{"text":"God is our refuge. Selah","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lowborn men are but a vapor,","poem":1},{"text":"the exalted but a lie.","poem":2},{"text":"Weighed on the scale, they go up;","poem":1},{"text":"together they are but a vapor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Place no trust in extortion,","poem":1},{"text":"or false hope in stolen goods.","poem":2},{"text":"If your riches increase,","poem":1},{"text":"do not set your heart upon them.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"God has spoken once;","poem":1},{"text":"I have heard this twice:","poem":2},{"text":"that power belongs to God,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"and loving devotion to You, O Lord.","poem":2},{"text":"For You will repay each man","poem":1},{"text":"according to his deeds.","poem":2},{"noteId":139}]}],"footnotes":[{"noteId":139,"text":"Cited in Romans 2:6","caller":"+","reference":{"chapter":62,"verse":12}}]},"thisChapterLink":"/api/BSB/PSA/62.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":62},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/62/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/62/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/62/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/63.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":63},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/63/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/63/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/63/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/61.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":61},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/61/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/61/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/61/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":12}