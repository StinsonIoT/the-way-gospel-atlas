{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":36,"content":[{"type":"heading","content":["The Transgression of the Wicked"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"For the choirmaster. A Psalm of David, the servant of the LORD.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"An oracle is in my heart","poem":1},{"text":"regarding the transgression of the wicked man:","poem":2},{"text":"There is no fear of God","poem":1},{"text":"before his eyes.","poem":2},{"noteId":81}]},{"type":"verse","number":2,"content":[{"text":"For his eyes are too full of conceit","poem":1},{"text":"to detect or hate his own sin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The words of his mouth are wicked and deceitful;","poem":1},{"text":"he has ceased to be wise and well-doing.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Even on his bed he plots wickedness;","poem":1},{"text":"he sets himself on a path that is not good;","poem":2},{"text":"he fails to reject evil.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Your loving devotion, O LORD, reaches to the heavens,","poem":1},{"text":"Your faithfulness to the clouds.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Your righteousness is like the highest mountains;","poem":1},{"text":"Your judgments are like the deepest sea.","poem":2},{"text":"O LORD, You preserve man and beast.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"How precious is Your loving devotion, O God,","poem":1},{"text":"that the children of men take refuge","poem":2},{"text":"in the shadow of Your wings!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"They feast on the abundance of Your house,","poem":1},{"text":"and You give them drink from Your river of delights.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"For with You is the fountain of life;","poem":1},{"text":"in Your light we see light.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Extend Your loving devotion to those who know You,","poem":1},{"text":"and Your righteousness to the upright in heart.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Let not the foot of the proud come against me,","poem":1},{"text":"nor the hand of the wicked drive me away.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"There the evildoers lie fallen,","poem":1},{"text":"thrown down and unable to rise.","poem":2}]}],"footnotes":[{"noteId":81,"text":"Cited in Romans 3:18","caller":"+","reference":{"chapter":36,"verse":1}}]},"thisChapterLink":"/api/BSB/PSA/36.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":36},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/36/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/36/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/36/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/37.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":37},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/37/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/37/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/37/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/35.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":35},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/35/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/35/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/35/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":12}