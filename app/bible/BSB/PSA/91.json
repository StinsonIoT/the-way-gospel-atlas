{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":91,"content":[{"type":"heading","content":["You Are My Refuge and My Fortress"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"I will say to the LORD, “You are my refuge and my fortress,","poem":1},{"text":"my God, in whom I trust.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Surely He will deliver you","poem":1},{"text":"from the snare of the fowler,","poem":2},{"text":"and from the deadly plague.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He will cover you with His feathers;","poem":1},{"text":"under His wings you will find refuge;","poem":2},{"text":"His faithfulness is a shield and rampart.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"You will not fear the terror of the night,","poem":1},{"text":"nor the arrow that flies by day,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nor the pestilence that stalks in the darkness,","poem":1},{"text":"nor the calamity that destroys at noon.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Though a thousand may fall at your side,","poem":1},{"text":"and ten thousand at your right hand,","poem":2},{"text":"no harm will come near you.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"You will only see it with your eyes","poem":1},{"text":"and witness the punishment of the wicked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Because you have made the LORD your dwelling—","poem":1},{"text":"my refuge, the Most High—","poem":2}]},{"type":"verse","number":10,"content":[{"text":"no evil will befall you,","poem":1},{"text":"no plague will approach your tent.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"For He will command His angels concerning you","poem":1},{"text":"to guard you in all your ways.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"They will lift you up in their hands,","poem":1},{"text":"so that you will not strike your foot against a stone.","poem":2},{"noteId":200}]},{"type":"verse","number":13,"content":[{"text":"You will tread on the lion and cobra;","poem":1},{"text":"you will trample the young lion and serpent.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Because he loves Me, I will deliver him;","poem":1},{"text":"because he knows My name, I will protect him.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"When he calls out to Me,","poem":1},{"text":"I will answer him;","poem":2},{"text":"I will be with him in trouble.","poem":1},{"text":"I will deliver him and honor him.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"With long life I will satisfy him","poem":1},{"text":"and show him My salvation.”","poem":2}]}],"footnotes":[{"noteId":199,"text":"Hebrew Shaddai","caller":"+","reference":{"chapter":91,"verse":1}},{"noteId":200,"text":"Cited in Matthew 4:6 and Luke 4:10–11","caller":"+","reference":{"chapter":91,"verse":12}}]},"thisChapterLink":"/api/BSB/PSA/91.json","thisChapterReference":{"translationId":"BSB","book":"PSA","chapter":91},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/91/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/91/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/91/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/PSA/92.json","nextChapterReference":{"translationId":"BSB","book":"PSA","chapter":92},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/92/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/92/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/92/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/PSA/90.json","previousChapterReference":{"translationId":"BSB","book":"PSA","chapter":90},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/PSA/90/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/PSA/90/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/PSA/90/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":15}