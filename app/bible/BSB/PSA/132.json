{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"PSA","name":"Psalm","commonName":"Psalms","title":"Psalm","order":19,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/PSA/1.json","firstChapterReference":{"translationId":"BSB","book":"PSA","chapter":1},"lastChapterNumber":150,"lastChapterApiLink":"/api/BSB/PSA/150.json","lastChapterReference":{"translationId":"BSB","book":"PSA","chapter":150},"numberOfChapters":150,"totalNumberOfVerses":2429},"chapter":{"number":132,"content":[{"type":"heading","content":["The LORD Has Chosen Zion"]},{"type":"line_break"},{"type":"hebrew_subtitle","content":[{"text":"A song of ascents.","poem":2}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O LORD, remember on behalf of David","poem":1},{"text":"all the hardships he endured,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"how he swore an oath to the LORD,","poem":1},{"text":"and vowed to the Mighty One of Jacob:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“I will not enter my house","poem":1},{"text":"or get into my bed,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I will not give sleep to my eyes","poem":1},{"text":"or slumber to my eyelids,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"until I find a place for the LORD,","poem":1},{"text":"a dwelling for the Mighty One of Jacob.","poem":2},{"noteId":268},{"text":"”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"We heard that the ark was in Ephrathah;","poem":1},{"noteId":269},{"text":"we found it in the fields of Jaar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Let us go to His dwelling place;","poem":1},{"text":"let us worship at His footstool.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Arise, O LORD, to Your resting place,","poem":1},{"text":"You and the ark of Your strength.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"May Your priests be clothed with righteousness,","poem":1},{"text":"and Your saints shout for joy.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"For the sake of Your servant David,","poem":1},{"text":"do not reject Your anointed one.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"The LORD swore an oath to David,","poem":1},{"text":"a promise He will not revoke:","poem":2},{"text":"“One of your descendants","poem":1},{"text":"I will place on your throne.","poem":2},{"noteId":270}]},{"type":"verse","number":12,"content":[{"text":"If your sons keep My covenant","poem":1},{"text":"and the testimony I will teach them,","poem":2},{"text":"then their sons will also sit on your throne","poem":1},{"text":"forever and ever.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"For the LORD has chosen Zion;","poem":1},{"text":"He has desired it for His home:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“This is My resting place forever and ever;","poem":1},{"text":"here I will dwell, for I have desired this home.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I will bless her with abundant provisions;","poem":1},{"text":"I will satisfy her poor with bread.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"I will clothe her priests with salvation,","poem":1},{"text":"and her saints will sing out in joy.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"There I will make a horn grow for David;","poem":1},{"text":"I have prepared a lamp for My anointed one.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I will clothe his enemies with 