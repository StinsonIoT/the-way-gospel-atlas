{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"JER","name":"Jeremiah","commonName":"Jeremiah","title":"Jeremiah","order":24,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/JER/1.json","firstChapterReference":{"translationId":"BSB","book":"JER","chapter":1},"lastChapterNumber":52,"lastChapterApiLink":"/api/BSB/JER/52.json","lastChapterReference":{"translationId":"BSB","book":"JER","chapter":52},"numberOfChapters":52,"totalNumberOfVerses":1364},"chapter":{"number":45,"content":[{"type":"heading","content":["Jeremiah’s Message to Baruch"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"This is the word that Jeremiah the prophet spoke to Baruch son of Neriah when he wrote these words on a scroll at the dictation of Jeremiah in the fourth year of Jehoiakim son of Josiah, king of Judah:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“This is what the LORD, the God of Israel, says to you, Baruch:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"You have said, ‘Woe is me because the LORD has added sorrow to my pain! I am worn out with groaning and have found no rest.’”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Thus Jeremiah was to say to Baruch:","poem":2},{"noteId":130},{"text":"“This is what the LORD says: Throughout the land I will demolish what I have built and uproot what I have planted.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"But as for you, do you seek great things for yourself? Stop seeking! For I will bring disaster on every living creature, declares the LORD, but wherever you go, I will grant your life as a spoil of war.”","poem":2}]}],"footnotes":[{"noteId":130,"text":"Literally Thus you shall say to him:","caller":"+","reference":{"chapter":45,"verse":4}}]},"thisChapterLink":"/api/BSB/JER/45.json","thisChapterReference":{"translationId":"BSB","book":"JER","chapter":45},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JER/45/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JER/45/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JER/45/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/JER/46.json","nextChapterReference":{"translationId":"BSB","book":"JER","chapter":46},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JER/46/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JER/46/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JER/46/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/JER/44.json","previousChapterReference":{"translationId":"BSB","book":"JER","chapter":44},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JER/44/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JER/44/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JER/44/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":5}