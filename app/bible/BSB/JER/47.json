{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"JER","name":"Jeremiah","commonName":"Jeremiah","title":"Jeremiah","order":24,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/JER/1.json","firstChapterReference":{"translationId":"BSB","book":"JER","chapter":1},"lastChapterNumber":52,"lastChapterApiLink":"/api/BSB/JER/52.json","lastChapterReference":{"translationId":"BSB","book":"JER","chapter":52},"numberOfChapters":52,"totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Judgment on the Philistines"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"This is the word of the LORD that came to Jeremiah the prophet about the Philistines before Pharaoh struck down Gaza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"This is what the LORD says:","poem":2},{"lineBreak":true},{"text":"“See how the waters are rising from the north","poem":1},{"text":"and becoming an overflowing torrent.","poem":2},{"text":"They will overflow the land and its fullness,","poem":1},{"text":"the cities and their inhabitants.","poem":2},{"text":"The people will cry out,","poem":1},{"text":"and all who dwell in the land will wail","poem":2}]},{"type":"verse","number":3,"content":[{"text":"at the sound of the galloping hooves of stallions,","poem":1},{"text":"the rumbling of chariots,","poem":2},{"text":"and the clatter of their wheels.","poem":2},{"text":"The fathers will not turn back for their sons;","poem":1},{"text":"their hands will hang limp.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"For the day has come","poem":1},{"text":"to destroy all the Philistines,","poem":2},{"text":"to cut off from Tyre and Sidon","poem":1},{"text":"every remaining ally.","poem":2},{"text":"Indeed, the LORD is about to destroy the Philistines,","poem":1},{"text":"the remnant from the coasts of Caphtor.","poem":2},{"noteId":135}]},{"type":"verse","number":5,"content":[{"text":"The people of Gaza will shave their heads in mourning;","poem":1},{"text":"Ashkelon will be silenced.","poem":2},{"text":"O remnant of their valley,","poem":1},{"noteId":136},{"text":"how long will you gash yourself?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"‘Alas, O sword of the LORD,","poem":1},{"text":"how long until you rest?","poem":2},{"text":"Return to your sheath;","poem":1},{"text":"cease and be still!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"How can it rest","poem":1},{"text":"when the LORD has commanded it?","poem":2},{"text":"He has appointed it against Ashkelon","poem":1},{"text":"and the shore of its coastland.”","poem":2}]}],"footnotes":[{"noteId":135,"text":"That is, Crete","caller":"+","reference":{"chapter":47,"verse":4}},{"noteId":136,"text":"That is, the Mediterranean coast or plain","caller":"+","reference":{"chapter":47,"verse":5}}]},"thisChapterLink":"/api/BSB/JER/47.json","thisChapterReference":{"translationId":"BSB","book":"JER","chapter":47},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JER/47/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JER/47/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JER/47/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/JER/48.json","nextChapterReference":{"translationId":"BSB","book":"JER","chapter":48},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JER/48/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JER/48/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JER/48/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/JER/46.json","previousChapterReference":{"translationId":"BSB","book":"JER","chapter":46},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JER/46/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JER/46/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JER/46/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":7}