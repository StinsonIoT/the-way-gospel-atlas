{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"REV","name":"Revelation","commonName":"Revelation","title":"Revelation","order":66,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/REV/1.json","firstChapterReference":{"translationId":"BSB","book":"REV","chapter":1},"lastChapterNumber":22,"lastChapterApiLink":"/api/BSB/REV/22.json","lastChapterReference":{"translationId":"BSB","book":"REV","chapter":22},"numberOfChapters":22,"totalNumberOfVerses":404},"chapter":{"number":15,"content":[{"type":"heading","content":["The Song of Moses and the Lamb"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Then I saw another great and marvelous sign in heaven: seven angels with the seven final plagues, with which the wrath of God is completed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"And I saw something like a sea of glass mixed with fire, beside which stood those who had conquered the beast and its image and the number of its name. They were holding harps from God,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"and they sang the song of God’s servant Moses and of the Lamb:","poem":2},{"lineBreak":true},{"text":"“Great and wonderful are Your works,","poem":1},{"text":"O Lord God Almighty!","poem":2},{"text":"Just and true are Your ways,","poem":1},{"text":"O King of the nations!","poem":2},{"noteId":41}]},{"type":"verse","number":4,"content":[{"text":"Who will not fear You, O Lord,","poem":1},{"text":"and glorify Your name?","poem":2},{"text":"For You alone are holy.","poem":2},{"text":"All nations will come and worship before You,","poem":1},{"text":"for Your righteous acts have been revealed.”","poem":2}]},{"type":"heading","content":["Preparation for Judgment"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"After this I looked, and the temple—the tabernacle of the Testimony—was opened in heaven.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"And out of the temple came the seven angels with the seven plagues, dressed in clean and bright linen and girded with golden sashes around their chests.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Then one of the four living creatures gave the seven angels seven golden bowls full of the wrath of God, who lives forever and ever.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"And the temple was filled with smoke from the glory of God and from His power; and no one could enter the temple until the seven plagues of the seven angels were completed.","poem":2}]}],"footnotes":[{"noteId":41,"text":"SBL and WH King of the ages; TR King of the saints","caller":"+","reference":{"chapter":15,"verse":3}}]},"thisChapterLink":"/api/BSB/REV/15.json","thisChapterReference":{"translationId":"BSB","book":"REV","chapter":15},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/REV/15/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/REV/15/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/REV/15/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/REV/16.json","nextChapterReference":{"translationId":"BSB","book":"REV","chapter":16},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/REV/16/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/REV/16/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/REV/16/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/REV/14.json","previousChapterReference":{"translationId":"BSB","book":"REV","chapter":14},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB