{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"ISA","name":"Isaiah","commonName":"Isaiah","title":"Isaiah","order":23,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/ISA/1.json","firstChapterReference":{"translationId":"BSB","book":"ISA","chapter":1},"lastChapterNumber":66,"lastChapterApiLink":"/api/BSB/ISA/66.json","lastChapterReference":{"translationId":"BSB","book":"ISA","chapter":66},"numberOfChapters":66,"totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Joyful Thanksgiving"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"In that day you will say:","poem":2},{"lineBreak":true},{"text":"“O LORD, I will praise You.","poem":1},{"text":"Although You were angry with me,","poem":2},{"text":"Your anger has turned away,","poem":1},{"text":"and You have comforted me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Surely God is my salvation;","poem":1},{"text":"I will trust and not be afraid.","poem":2},{"text":"For the LORD GOD is my strength and my song,","poem":1},{"text":"and He also has become my salvation.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"With joy you will draw water from the springs of salvation,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"and on that day you will say:","poem":2},{"lineBreak":true},{"text":"“Give praise to the LORD;","poem":1},{"text":"proclaim His name!","poem":2},{"text":"Make His works known among the peoples;","poem":1},{"text":"declare that His name is exalted.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sing to the LORD, for He has done