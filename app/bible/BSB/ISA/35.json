{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"ISA","name":"Isaiah","commonName":"Isaiah","title":"Isaiah","order":23,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/ISA/1.json","firstChapterReference":{"translationId":"BSB","book":"ISA","chapter":1},"lastChapterNumber":66,"lastChapterApiLink":"/api/BSB/ISA/66.json","lastChapterReference":{"translationId":"BSB","book":"ISA","chapter":66},"numberOfChapters":66,"totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["The Glory of Zion"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"The wilderness and the land will be glad;","poem":1},{"text":"the desert will rejoice and blossom like a rose.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"It will bloom profusely","poem":1},{"text":"and rejoice with joy and singing.","poem":2},{"text":"The glory of Lebanon will be given to it,","poem":1},{"text":"the splendor of Carmel and Sharon.","poem":2},{"text":"They will see the glory of the LORD,","poem":1},{"text":"the splendor of our God.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Strengthen the limp hands","poem":1},{"text":"and steady the feeble knees!","poem":2},{"noteId":117}]},{"type":"verse","number":4,"content":[{"text":"Say to those with anxious hearts:","poem":1},{"text":"“Be strong, do not fear!","poem":2},{"text":"Behold, your God will come with vengeance.","poem":1},{"text":"With divine retribution He will come to save you.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Then the eyes of the blind will be opened","poem":1},{"text":"and the ears of the deaf unstopped.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Then the lame will leap like a deer","poem":1},{"text":"and the mute tongue will shout for joy.","poem":2},{"text":"For waters will gush forth in the wilderness,","poem":1},{"text":"and streams in the desert.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"The parched ground will become a pool,","poem":1},{"text":"the thirsty land springs of water.","poem":2},{"text":"In the haunt where jackals","poem":1},{"noteId":118},{"text":"once lay,","poem":1},{"text":"there will be grass and reeds and papyrus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"And there will be a highway","poem":1},{"text":"called the Way of Holiness.","poem":2},{"text":"The unclean will not travel it—","poem":1},{"text":"only those who walk in the Way—","poem":2},{"text":"and fools will not stray onto it.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"No lion will be there,","poem":1},{"text":"and no vicious beast will go up on it.","poem":2},{"text":"Such will not be found there,","poem":1},{"text":"but the redeemed will walk upon it.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"So the redeemed of the LORD will return","poem":1},{"text":"and enter Zion with singing,","poem":2},{"text":"crowned with everlasting joy.","poem":2},{"text":"Gladness and joy will overtake them,","poem":1},{"text":"and sorrow and sighing will flee.","poem":2}]}],"footnotes":[{"noteId":117,"text":"Cited in Hebrews 12:12","caller":"+","reference":{"chapter":35,"verse":3}},{"noteId":118,"text":"Or serpents or dragons","caller":"+","reference":{"chapter":35,"verse":7}}]},"thisChapterLink":"/api/BSB/ISA/35.json","thisChapterReference":{"translationId":"BSB","book":"ISA","chapter":35},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ISA/35/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ISA/35/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ISA/35/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/ISA/36.json","nextChapterReference":{"translationId":"BSB","book":"ISA","chapter":36},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ISA/36/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ISA/36/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ISA/36/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/ISA/34.json","previousChapterReference":{"translationId":"BSB","book":"ISA","chapter":34},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ISA/34/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ISA/34/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ISA/34/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":10}