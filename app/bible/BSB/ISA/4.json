{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"ISA","name":"Isaiah","commonName":"Isaiah","title":"Isaiah","order":23,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/ISA/1.json","firstChapterReference":{"translationId":"BSB","book":"ISA","chapter":1},"lastChapterNumber":66,"lastChapterApiLink":"/api/BSB/ISA/66.json","lastChapterReference":{"translationId":"BSB","book":"ISA","chapter":66},"numberOfChapters":66,"totalNumberOfVerses":1292},"chapter":{"number":4,"content":[{"type":"heading","content":["A Remnant in Zion"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"In that day seven women","poem":1},{"text":"will take hold of one man and say,","poem":2},{"text":"“We will eat our own bread","poem":1},{"text":"and provide our own clothes.","poem":2},{"text":"Just let us be called by your name.","poem":1},{"text":"Take away our disgrace!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"On that day the Branch of the LORD","poem":1},{"text":"will be beautiful and glorious,","poem":2},{"text":"and the fruit of the land","poem":1},{"text":"will be the pride and glory of Israel’s survivors.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Whoever remains in Zion","poem":1},{"text":"and whoever is left in Jerusalem","poem":2},{"text":"will be called holy—","poem":1},{"text":"all in Jerusalem who are recorded among the living—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"when the Lord has washed away","poem":1},{"text":"the filth of the daughters of Zion","poem":2},{"text":"and cleansed the bloodstains from the heart of Jerusalem","poem":1},{"text":"by a spirit of judgment and a spirit of fire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Then the LORD will create over all of Mount Zion","poem":1},{"text":"and over her assemblies","poem":2},{"text":"a cloud of smoke by day","poem":1},{"text":"and a glowing flame of fire by night.","poem":2},{"text":"For over all the glory","poem":1},{"text":"there will be a canopy,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"a shelter to give shade","poem":1},{"text":"from the heat by day,","poem":2},{"text":"and a refuge and hiding place","poem":1},{"text":"from the storm and the rain.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/BSB/ISA/4.json","thisChapterReference":{"translationId":"BSB","book":"ISA","chapter":4},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ISA/4/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ISA/4/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ISA/4/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/ISA/5.json","nextChapterReference":{"translationId":"BSB","book":"ISA","chapter":5},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ISA/5/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ISA/5/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ISA/5/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/ISA/3.json","previousChapterReference":{"translationId":"BSB","book":"ISA","chapter":3},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ISA/3/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ISA/3/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ISA/3/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":6}