{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"ISA","name":"Isaiah","commonName":"Isaiah","title":"Isaiah","order":23,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/ISA/1.json","firstChapterReference":{"translationId":"BSB","book":"ISA","chapter":1},"lastChapterNumber":66,"lastChapterApiLink":"/api/BSB/ISA/66.json","lastChapterReference":{"translationId":"BSB","book":"ISA","chapter":66},"numberOfChapters":66,"totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["The Burden against Moab"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"This is the burden against Moab:","poem":2},{"lineBreak":true},{"text":"Ar in Moab is ruined,","poem":1},{"text":"destroyed in a night!","poem":2},{"text":"Kir in Moab is devastated,","poem":1},{"text":"destroyed in a night!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dibon goes up to its temple","poem":1},{"text":"to weep at its high places.","poem":2},{"text":"Moab wails over Nebo,","poem":1},{"text":"as well as over Medeba.","poem":2},{"lineBreak":true},{"text":"Every head is shaved,","poem":1},{"text":"every beard is cut off.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"In its streets they wear sackcloth;","poem":1},{"text":"on the rooftops and in the public squares","poem":2},{"text":"they all wail, falling down weeping.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Heshbon and Elealeh cry out;","poem":1},{"text":"their voices are heard as far as Jahaz.","poem":2},{"text":"Therefore the soldiers of Moab cry out;","poem":1},{"text":"their souls tremble within.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"My heart cries out over Moab;","poem":1},{"text":"her fugitives flee as far as Zoar,","poem":2},{"text":"as far as Eglath-shelishiyah.","poem":2},{"noteId":60},{"text":"With weeping they ascend the slope of Luhith;","poem":1},{"text":"they lament their destruction on the road to Horonaim.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The waters of Nimrim are dried up,","poem":1},{"text":"and the grass is withered;","poem":2},{"text":"the vegetation is gone,","poem":1},{"text":"and the greenery is no more.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"So they carry their wealth and belongings","poem":1},{"text":"over the Brook of the Willows.","poem":2},{"noteId":61}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"For their outcry echoes to the border of Moab.","poem":1},{"text":"Their wailing reaches Eglaim;","poem":2},{"text":"it is heard in Beer-elim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"The waters of Dimon","poem":1},{"noteId":62},{"text":"are full of blood,","poem":1},{"text":"but I will bring more upon Dimon—","poem":2},{"text":"a lion upon the fugitives of Moab","poem":1},{"text":"and upon the remnant of the land.","poem":2}]}],"footnotes":[{"noteId":60,"text":"Or Zoar, like a heifer three years of age.","caller":"+","reference":{"chapter":15,"verse":5}},{"noteId":61,"text":"Or Poplars","caller":"+","reference":{"chapter":15,"verse":7}},{"noteId":62,"text":"MT, twice in this verse; DSS and Vulgate Dibon; Dimon, a wordplay on Dibon (see verse 2), sounds like the Hebrew for blood.","caller":"+","reference":{"chapter":15,"verse":9}}]},"thisChapterLink":"/api/BSB/ISA/15.json","thisChapterReference":{"translationId":"BSB","book":"ISA","chapter":15},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ISA/15/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ISA/15/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ISA/15/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/ISA/16.json","nextChapterReference":{"translationId":"BSB","book":"ISA","chapter":16},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ISA/16/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ISA/16/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ISA/16/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/ISA/14.json","previousChapterReference":{"translationId":"BSB","book":"ISA","chapter":14},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ISA/14/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ISA/14/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ISA/14/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":9}