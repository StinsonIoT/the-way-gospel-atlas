{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"SNG","name":"Song","commonName":"Song of Solomon","title":"Song","order":22,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/SNG/1.json","firstChapterReference":{"translationId":"BSB","book":"SNG","chapter":1},"lastChapterNumber":8,"lastChapterApiLink":"/api/BSB/SNG/8.json","lastChapterReference":{"translationId":"BSB","book":"SNG","chapter":8},"numberOfChapters":8,"totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"heading","content":["The Bride Confesses Her Love"]},{"type":"line_break"},{"type":"verse","number":1,"content":["This is Solomon’s Song of Songs.",{"noteId":0}]},{"type":"heading","content":["The Bride"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Let him kiss me with the kisses of his mouth!","poem":1},{"text":"For your love is more delightful than wine.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The fragrance of your perfume is pleasing;","poem":1},{"text":"your name is like perfume poured out.","poem":2},{"text":"No wonder the maidens adore you.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Take me away with you—let us hurry!","poem":1},{"text":"May the king bring me to his chambers.","poem":2},{"heading":"The Friends"},{"lineBreak":true},{"text":"We will rejoice and delight in you;","poem":1},{"text":"we will praise your love more than wine.","poem":2},{"heading":"The Bride"},{"lineBreak":true},{"text":"It is only right that they adore you.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I am dark, yet lovely, O daughters of Jerusalem,","poem":1},{"text":"like the tents of Kedar, like the curtains of Solomon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Do not stare because I am dark,","poem":1},{"text":"for the sun has gazed upon me.","poem":2},{"text":"My mother’s sons were angry with me;","poem":1},{"text":"they made me a keeper of the vineyards,","poem":2},{"text":"but my own vineyard I have neglected.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tell me, O one I love,","poem":1},{"text":"where do you pasture your sheep?","poem":2},{"text":"Where do you rest them at midday?","poem":2},{"text":"Why should I be like a veiled woman","poem":1},{"text":"beside the flocks of your companions?","poem":2}]},{"type":"heading","content":["The Friends"]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"If you do not know, O fairest of women,","poem":1},{"text":"follow the tracks of the flock,","poem":2},{"text":"and graze your young goats","poem":1},{"text":"near the tents of the shepherds.","poem":2}]},{"type":"heading","content":["The Bridegroom"]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I compare you, my darling,","poem":1},{"text":"to a mare among Pharaoh’s chariots.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Your cheeks are beautiful with ornaments,","poem":1},{"text":"your neck with strings of jewels.","poem":2}]},{"type":"heading","content":["The Friends"]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"We will make you ornaments of gold,","poem":1},{"text":"studded with beads of silver.","poem":2}]},{"type":"heading","content":["The Bride"]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"While the king was at his table,","poem":1},{"text":"my perfume spread its fragrance.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"My beloved is to me a sachet of myrrh","poem":1},{"text":"resting between my breasts.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"My beloved is to me a cluster of henna blossoms","poem":1},{"text":"in the vineyards of En-gedi.","poem":2}]},{"type":"heading","content":["The Bridegroom"]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"How beautiful you are, my darling!","poem":1},{"text":"Oh, how very beautiful!","poem":2},{"text":"Your eyes are like doves.","poem":2}]},{"type":"heading","content":["The Bride"]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"How handsome you are, my beloved!","poem":1},{"text":"Oh, how delightful!","poem":2},{"text":"The soft grass is our bed.","poem":2}]},{"type":"heading","content":["The Bridegroom"]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"The beams of our house are cedars;","poem":1},{"text":"our rafters are fragrant firs.","poem":2}]}],"footnotes":[{"noteId":0,"text":"Most translators add subheadings for speaker identifications such as The Bride, The Groom, and The Friends based on the gender and number of the Hebrew words.","caller":"+","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/BSB/SNG/1.json","thisChapterReference":{"translationId":"BSB","book":"SNG","chapter":1},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/SNG/1/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/SNG/1/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/SNG/1/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/SNG/2.json","nextChapterReference":{"translationId":"BSB","book":"SNG","chapter":2},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/SNG/2/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/SNG/2/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/SNG/2/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/ECC/12.json","previousChapterReference":{"translationId":"BSB","book":"ECC","chapter":12},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/ECC/12/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/ECC/12/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/ECC/12/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":17}