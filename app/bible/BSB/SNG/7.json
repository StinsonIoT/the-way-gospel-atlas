{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"SNG","name":"Song","commonName":"Song of Solomon","title":"Song","order":22,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/SNG/1.json","firstChapterReference":{"translationId":"BSB","book":"SNG","chapter":1},"lastChapterNumber":8,"lastChapterApiLink":"/api/BSB/SNG/8.json","lastChapterReference":{"translationId":"BSB","book":"SNG","chapter":8},"numberOfChapters":8,"totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"heading","content":["Admiration by the Bridegroom"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"How beautiful are your sandaled feet,","poem":1},{"text":"O daughter of the prince!","poem":2},{"text":"The curves of your thighs are like jewels,","poem":1},{"text":"the handiwork of a master.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Your navel is a rounded goblet;","poem":1},{"text":"it never lacks blended wine.","poem":2},{"text":"Your waist is a mound of wheat","poem":1},{"text":"encircled by the lilies.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Your breasts are like two fawns,","poem":1},{"text":"twins of a gazelle.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Your neck is like a tower","poem":1},{"text":"made of ivory;","poem":2},{"text":"your eyes are like the pools of Heshbon","poem":1},{"text":"by the gate of Bath-rabbim;","poem":2},{"text":"your nose is like the tower of Lebanon,","poem":1},{"text":"facing toward Damascus.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Your head crowns you like Mount Carmel,","poem":1},{"text":"the hair of your head like purple threads;","poem":2},{"text":"the king is captured in your tresses.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"How fair and pleasant you are,","poem":1},{"text":"O love, with your delights!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Your stature is like a palm tree;","poem":1},{"text":"your breasts are clusters of fruit.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I said, “I will climb the palm tree;","poem":1},{"text":"I will take hold of its fruit.”","poem":2},{"text":"May your breasts be like clusters of the vine,","poem":1},{"text":"the fragrance of your breath like apples,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"and your mouth","poem":2},{"noteId":11},{"text":"like the finest wine.","poem":2},{"heading":"The Bride"},{"lineBreak":true},{"text":"May it flow smoothly to my beloved,","poem":1},{"text":"gliding gently over lips and teeth.","poem":2},{"noteId":12}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I belong to my beloved,","poem":1},{"text":"and his desire is for me.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Come, my beloved,","poem":1},{"text":"let us go to the countryside;","poem":2},{"text":"let us spend the night among the wildflowers.","poem":2},{"noteId":13}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Let us go early to the vineyards","poem":1},{"text":"to see if the vine has budded,","poem":2},{"text":"if the blossom has opened,","poem":1},{"text":"if the pomegranates are in bloom—","poem":2},{"text":"there I will give you my love.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"The mandrakes send forth a fragrance,","poem":1},{"text":"and at our door is every delicacy,","poem":2},{"text":"new as well as old,","poem":1},{"text":"that I have treasured up for you, my beloved.","poem":2}]}],"footnotes":[{"noteId":11,"text":"Hebrew palate","caller":"+","reference":{"chapter":7,"verse":9}},{"noteId":12,"text":"LXX, Syriac, and Vulgate; Hebrew gliding gently over lips as we sleep","caller":"+","reference":{"chapter":7,"verse":9}},{"noteId":13,"text":"Or among the henna blossoms or in the villages","caller":"+","reference":{"chapter":7,"verse":11}}]},"thisChapterLink":"/api/BSB/SNG/7.json","thisChapterReference":{"translationId":"BSB","book":"SNG","chapter":7},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/SNG/7/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/SNG/7/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/SNG/7/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/SNG/8.json","nextChapterReference":{"translationId":"BSB","book":"SNG","chapter":8},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/SNG/8/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/SNG/8/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/SNG/8/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/SNG/6.json","previousChapterReference":{"translationId":"BSB","book":"SNG","chapter":6},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/SNG/6/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/SNG/6/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/SNG/6/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":13}