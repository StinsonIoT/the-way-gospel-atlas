{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"SNG","name":"Song","commonName":"Song of Solomon","title":"Song","order":22,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/SNG/1.json","firstChapterReference":{"translationId":"BSB","book":"SNG","chapter":1},"lastChapterNumber":8,"lastChapterApiLink":"/api/BSB/SNG/8.json","lastChapterReference":{"translationId":"BSB","book":"SNG","chapter":8},"numberOfChapters":8,"totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"heading","content":["The Bride and Her Beloved"]},{"type":"heading","content":["The Bridegroom"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I have come to my garden, my sister, my bride;","poem":1},{"text":"I have gathered my myrrh with my spice.","poem":2},{"text":"I have eaten my honeycomb with my honey;","poem":1},{"text":"I have drunk my wine with my milk.","poem":2},{"heading":"The Friends"},{"lineBreak":true},{"text":"Eat, O friends, and drink;","poem":1},{"text":"drink freely, O beloved.","poem":2}]},{"type":"heading","content":["The Bride"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"I sleep, but my heart is awake.","poem":1},{"text":"A sound! My beloved is knocking:","poem":2},{"text":"“Open to me, my sister, my darling,","poem":1},{"text":"my dove, my flawless one.","poem":2},{"text":"My head is drenched with dew,","poem":1},{"text":"my hair with the dampness of the night.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"I have taken off my robe—","poem":1},{"text":"must I put it back on?","poem":2},{"text":"I have washed my feet—","poem":1},{"text":"must I soil them again?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"My beloved put his hand to the latch;","poem":1},{"text":"my heart pounded for him.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I rose up to open for my beloved.","poem":1},{"text":"My hands dripped with myrrh,","poem":2},{"text":"my fingers with flowing myrrh","poem":1},{"text":"on the handles of the bolt.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I opened for my beloved,","poem":1},{"text":"but he had turned and gone.","poem":2},{"text":"My heart sank at his departure.","poem":1},{"text":"I sought him, but did not find him.","poem":2},{"text":"I called, but he did not answer.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I encountered the watchmen on their rounds of the city.","poem":1},{"text":"They beat me and bruised me;","poem":2},{"text":"they took away my cloak,","poem":1},{"text":"those guardians of the walls.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O daughters of Jerusalem, I adjure you,","poem":1},{"text":"if you find my beloved,","poem":2},{"text":"tell him I am sick with love.","poem":2}]},{"type":"heading","content":["The Friends"]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"How is your beloved better than others,","poem":1},{"text":"O most beautiful among women?","poem":2},{"text":"How is your beloved better than another,","poem":1},{"text":"that you charge us so?","poem":2}]},{"type":"heading","content":["The Bride"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"My beloved is dazzling and ruddy,","poem":1},{"text":"outstanding among ten thousand.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"His head is purest gold;","poem":1},{"text":"his hair is wavy and black as a raven.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"His eyes are like doves","poem":1},{"text":"beside the streams of water,","poem":2},{"text":"bathed in milk","poem":1},{"text":"and mounted like jewels.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"His cheeks are like beds of spice,","poem":1},{"text":"towers of perfume.","poem":2},{"text":"His lips are like lilies,","poem":1},{"text":"dripping with flowing myrrh.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"His arms are rods of gold","poem":1},{"text":"set with beryl.","poem":2},{"text":"His body is an ivory panel","poem":1},{"text":"bedecked with sapphires.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"His legs are pillars of marble","poem":1},{"text":"set on bases of pure gold.","poem":2},{"text":"His appearance is like Lebanon,","poem":1},{"text":"as majestic as the cedars.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"His mouth","poem":1},{"noteId":8},{"text":"is most sweet;","poem":1},{"text":"he is altogether lovely.","poem":2},{"text":"This is my beloved, and this is my friend,","poem":1},{"text":"O daughters of Jerusalem.","poem":2}]}],"footnotes":[{"noteId":8,"text":"Hebrew palate","caller":"+","reference":{"chapter":5,"verse":16}}]},"thisChapterLink":"/api/BSB/SNG/5.json","thisChapterReference":{"translationId":"BSB","book":"SNG","chapter":5},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/SNG/5/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/SNG/5/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/SNG/5/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/SNG/6.json","nextChapterReference":{"translationId":"BSB","book":"SNG","chapter":6},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/SNG/6/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/SNG/6/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/SNG/6/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/SNG/4.json","previousChapterReference":{"translationId":"BSB","book":"SNG","chapter":4},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/SNG/4/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/SNG/4/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/SNG/4/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":16}