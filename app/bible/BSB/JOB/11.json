{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"JOB","name":"Job","commonName":"Job","title":"Job","order":18,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/JOB/1.json","firstChapterReference":{"translationId":"BSB","book":"JOB","chapter":1},"lastChapterNumber":42,"lastChapterApiLink":"/api/BSB/JOB/42.json","lastChapterReference":{"translationId":"BSB","book":"JOB","chapter":42},"numberOfChapters":42,"totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Zophar Rebukes Job"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Then Zophar the Naamathite replied:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Should this stream of words go unanswered","poem":1},{"text":"and such a speaker be vindicated?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Should your babbling put others to silence?","poem":1},{"text":"Will you scoff without rebuke?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"You have said, ‘My doctrine is sound,","poem":1},{"text":"and I am pure in Your sight.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"But if only God would speak","poem":1},{"text":"and open His lips against you,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"and disclose to you the secrets of wisdom,","poem":1},{"text":"for true wisdom has two sides.","poem":2},{"text":"Know then that God exacts from you","poem":1},{"text":"less than your iniquity deserves.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Can you fathom the deep things of God","poem":1},{"text":"or discover the limits of the Almighty?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"They are higher than the heavens—what can you do?","poem":1},{"text":"They are deeper than Sheol—what can you know?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Their measure is longer than the earth","poem":1},{"text":"and wider than the sea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"If He comes along to imprison you,","poem":1},{"text":"or convenes a court, who can stop Him?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Surely He knows the deceit of men.","poem":1},{"text":"If He sees iniquity, does He not take note?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"But a witless man can no more become wise","poem":1},{"text":"than the colt of a wild donkey can be born a man!","poem":2},{"noteId":17}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"As for you, if you direct your heart","poem":1},{"text":"and lift up your hands to Him,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"if you put away the iniquity in your hand,","poem":1},{"text":"and allow no injustice to dwell in your tents,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"then indeed you will lift up your face without shame;","poem":1},{"text":"you will stand firm and unafraid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"For you will forget your misery,","poem":1},{"text":"recalling it only as waters gone by.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Your life will be brighter than noonday;","poem":1},{"text":"its darkness will be like the morning.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"You will be secure, because there is hope,","poem":1},{"text":"and you will look around and lie down in safety.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"You will lie down without fear,","poem":1},{"text":"and many will court your favor.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"But the eyes of the wicked will fail,","poem":1},{"text":"and escape will elude them;","poem":2},{"text":"they will hope for their last breath.”","poem":2}]}],"footnotes":[{"noteId":17,"text":"Or can be born tame","caller":"+","reference":{"chapter":11,"verse":12}}]},"thisChapterLink":"/api/BSB/JOB/11.json","thisChapterReference":{"translationId":"BSB","book":"JOB","chapter":11},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JOB/11/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JOB/11/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JOB/11/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/JOB/12.json","nextChapterReference":{"translationId":"BSB","book":"JOB","chapter":12},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JOB/12/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JOB/12/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JOB/12/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/JOB/10.json","previousChapterReference":{"translationId":"BSB","book":"JOB","chapter":10},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JOB/10/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JOB/10/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JOB/10/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":20}