{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"JOB","name":"Job","commonName":"Job","title":"Job","order":18,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/JOB/1.json","firstChapterReference":{"translationId":"BSB","book":"JOB","chapter":1},"lastChapterNumber":42,"lastChapterApiLink":"/api/BSB/JOB/42.json","lastChapterReference":{"translationId":"BSB","book":"JOB","chapter":42},"numberOfChapters":42,"totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"heading","content":["Elihu Recalls God’s Justice"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"And Elihu went on to say:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Do you think this is just?","poem":1},{"text":"You say, ‘I am more righteous than God.’","poem":2},{"noteId":55}]},{"type":"verse","number":3,"content":[{"text":"For you ask, ‘What does it profit me,","poem":1},{"text":"and what benefit do I gain apart from sin?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I will reply to you","poem":1},{"text":"and to your friends as well.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Look to the heavens and see;","poem":1},{"text":"gaze at the clouds high above you.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"If you sin, what do you accomplish against Him?","poem":1},{"text":"If you multiply your transgressions, what do you do to Him?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"If you are righteous, what do you give Him,","poem":1},{"text":"or what does He receive from your hand?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Your wickedness affects only a man like yourself,","poem":1},{"text":"and your righteousness only a son of man.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Men cry out under great oppression;","poem":1},{"text":"they plead for relief from the arm of the mighty.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"But no one asks, ‘Where is God my Maker,","poem":1},{"text":"who gives us songs in the night,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"who teaches us more than the beasts of the earth","poem":1},{"text":"and makes us wiser than the birds of the air?’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"There they cry out, but He does not answer,","poem":1},{"text":"because of the pride of evil men.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Surely God does not listen to empty pleas,","poem":1},{"text":"and the Almighty does not take note of it.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"How much less, then, when you say that you do not see Him,","poem":1},{"text":"that your case is before Him and you must wait for Him,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"and further, that in His anger He has not punished","poem":1},{"text":"or taken much notice of folly!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"So Job opens his mouth in vain","poem":1},{"text":"and multiplies words without knowledge.”","poem":2}]}],"footnotes":[{"noteId":55,"text":"Or ‘I am righteous before God.’","caller":"+","reference":{"chapter":35,"verse":2}}]},"thisChapterLink":"/api/BSB/JOB/35.json","thisChapterReference":{"translationId":"BSB","book":"JOB","chapter":35},"thisChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JOB/35/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JOB/35/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JOB/35/audio/david.mp3"},"nextChapterApiLink":"/api/BSB/JOB/36.json","nextChapterReference":{"translationId":"BSB","book":"JOB","chapter":36},"nextChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JOB/36/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JOB/36/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JOB/36/audio/david.mp3"},"previousChapterApiLink":"/api/BSB/JOB/34.json","previousChapterReference":{"translationId":"BSB","book":"JOB","chapter":34},"previousChapterAudioLinks":{"hays":"https://audio.bible.helloao.org/api/BSB/JOB/34/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JOB/34/audio/souer.mp3","david":"https://audio.bible.helloao.org/api/BSB/JOB/34/audio/david.mp3"},"thisChapterAudioTimings":{},"nextChapterAudioTimings":{},"previousChapterAudioTimings":{},"numberOfVerses":16}