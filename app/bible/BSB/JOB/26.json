{"translation":{"id":"BSB","name":"Berean Standard Bible","englishName":"Berean Standard Bible","shortName":"BSB","language":"en-US","licenseUrl":"https://berean.bible/terms.htm","website":"https://berean.bible","textDirection":"ltr","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31054},"book":{"id":"JOB","name":"Job","commonName":"Job","title":"Job","order":18,"firstChapterNumber":1,"firstChapterApiLink":"/api/BSB/JOB/1.json","firstChapterReference":{"translationId":"BSB","book":"JOB","chapter":1},"lastChapterNumber":42,"lastChapterApiLink":"/api/BSB/JOB/42.json","lastChapterReference":{"translationId":"BSB","book":"JOB","chapter":42},"numberOfChapters":42,"totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Job: Who Can Understand God’s Majesty?"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Then Job answered:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“How you have helped the powerless","poem":1},{"text":"and saved the arm that is feeble!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"How you have counseled the unwise","poem":1},{"text":"and provided fully sound insight!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"To whom have you uttered these words?","poem":1},{"text":"And whose spirit spoke through you?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"The dead tremble—","poem":1},{"text":"those beneath the waters and those who dwell in them.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sheol is naked before God,","poem":1},{"text":"and Abaddon","poem":2},{"noteId":32},{"text":"has no covering.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He stretches out the north over empty space;","poem":1},{"text":"He hangs the earth upon nothing.","poem":2}]},{"type":"verse","number":8,"co