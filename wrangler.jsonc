{
  // The Way: a static site, served by Workers Static Assets.
  // Which files ship is set by .assetsignore; nothing here deploys by itself.
  "name": "the-way-atlas",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Serve every file at its exact path. The service worker precaches
    // about.html and friends, and a redirect to /about would break that.
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
